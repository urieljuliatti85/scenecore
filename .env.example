DATABASE_URL=postgres://scenecore:scenecore@localhost:5433/scenecore_development

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable Google
# Analytics and the cookie consent banner entirely.
GOOGLE_ANALYTICS_ID=

# GA4 numeric Property ID (NOT the Account ID — find it at Admin > Property
# Details in Google Analytics, or in the URL as .../a<ACCOUNT_ID>p<PROPERTY_ID>/...).
# Needed for the admin traffic dashboard to read reports via the Google
# Analytics Data API. The service account backing it needs Viewer access
# granted in GA4's Property Access Management.
GOOGLE_ANALYTICS_PROPERTY_ID=

# The service account's credentials, as ONE of:
#   - a JSON key file at config/google_analytics_credentials.json
#     (gitignored, never committed — used for local development), OR
#   - the same JSON's raw content pasted into GOOGLE_ANALYTICS_CREDENTIALS_JSON
#     below (used on hosts like Railway that can't mount a file as a secret;
#     takes precedence over the file when both are set)
GOOGLE_ANALYTICS_CREDENTIALS_JSON=

# Discogs API credentials, for importing product metadata from a release in
# Band Admin > Store. Without these the Discogs search returns 503 and the
# rest of the Store still works — products can be created by hand.
#
# Provide ONE of:
#   - a personal access token (simplest for local development; generate one
#     at https://www.discogs.com/settings/developers), OR
#   - the consumer key/secret pair of a registered Discogs application
#
# A token wins over the key/secret pair when both are set. Rails credentials
# (discogs: token: / consumer_key: / consumer_secret:) take precedence over
# these variables.
DISCOGS_TOKEN=
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
