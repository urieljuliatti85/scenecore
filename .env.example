DATABASE_URL=postgres://scenecore:scenecore@localhost:5433/scenecore_development

# GA4 Measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable Google
# Analytics and the cookie consent banner entirely.
GOOGLE_ANALYTICS_ID=

# GA4 numeric Property ID (NOT the Account ID — find it at Admin > Property
# Details in Google Analytics, or in the URL as .../a<ACCOUNT_ID>p<PROPERTY_ID>/...).
# Needed for the admin traffic dashboard to read reports via the Google
# Analytics Data API. Also requires a service account JSON key at
# config/google_analytics_credentials.json (gitignored, never committed)
# with Viewer access granted to it in GA4's Property Access Management.
GOOGLE_ANALYTICS_PROPERTY_ID=
