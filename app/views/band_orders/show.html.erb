<% content_for :title, "Order ##{@order.id} — #{@band.name} — SceneCore" %>

<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-2xl mx-auto">
  <%= link_to band_path(@band, tab: "orders"), class: "text-sm text-neutral-400 hover:text-white transition" do %>
    &larr; Orders
  <% end %>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3 mb-2">
    <h1 class="text-3xl font-extrabold tracking-tight">Order #<%= @order.id %></h1>
    <%= render "orders/status_badge", order: @order %>
  </div>

  <p class="text-neutral-400 mb-8">
    <%= @order.user.name %> · <%= @order.created_at.strftime("%d %b %Y") %>
  </p>

  <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-6">
    <ul class="flex flex-col gap-2 text-sm mb-4">
      <% @order.order_items.each do |item| %>
        <li class="flex items-start justify-between gap-4">
          <span class="text-neutral-300 min-w-0">
            <%= item.quantity %>&times; <%= item.product_name %>
            <span class="text-neutral-500">(<%= item.variant_name %>)</span>
          </span>
          <span class="text-white shrink-0">
            <%= number_to_currency(item.quantity * item.unit_price_cents / 100.0) %>
          </span>
        </li>
      <% end %>
    </ul>

    <dl class="flex flex-col gap-2 text-sm border-t border-neutral-800 pt-4">
      <div class="flex items-center justify-between">
        <dt class="text-neutral-400">Subtotal</dt>
        <dd class="text-white"><%= number_to_currency(@order.subtotal_cents / 100.0) %></dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-neutral-400">Shipping</dt>
        <dd class="text-white">
          <%= @order.shipping_cents.zero? ? "Free" : number_to_currency(@order.shipping_cents / 100.0) %>
        </dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-neutral-400">Total the fan paid</dt>
        <dd class="text-white"><%= number_to_currency(@order.total_cents / 100.0) %></dd>
      </div>

      <%# The band's own share, which is what it actually receives — the
          platform fee was already taken at the moment of the charge. %>
      <div class="flex items-center justify-between pt-3 mt-1 border-t border-neutral-800">
        <dt class="font-semibold text-white">
          Your share
          <span class="block text-neutral-500 text-xs font-normal mt-0.5">
            After SceneCore's <%= number_to_currency(@order.platform_fee_cents / 100.0) %> commission
          </span>
        </dt>
        <dd class="text-xl font-extrabold text-white">
          <%= number_to_currency((@order.total_cents - @order.platform_fee_cents) / 100.0) %>
        </dd>
      </div>
    </dl>
  </div>

  <% if @order.shipping_address %>
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-6">
      <h2 class="text-sm font-semibold text-white mb-3">Ship to</h2>
      <address class="text-sm text-neutral-400 not-italic leading-relaxed">
        <%= @order.shipping_address.recipient_name %><br>
        <%= @order.shipping_address.line1 %><br>
        <% if @order.shipping_address.line2.present? %>
          <%= @order.shipping_address.line2 %><br>
        <% end %>
        <%= @order.shipping_address.city %>, <%= @order.shipping_address.state %>
        <%= @order.shipping_address.postal_code %><br>
        <%= @order.shipping_address.country %>
      </address>
    </div>
  <% end %>

  <% if policy(@order).fulfil? %>
    <%= button_to "Mark #{@order.next_fulfilment_status}", fulfil_band_order_path(@band, @order), method: :patch,
          class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
  <% elsif @order.pending? %>
    <p class="text-sm text-neutral-500">
      Waiting for Stripe to confirm this payment. Nothing to send until it does.
    </p>
  <% end %>

  <% if @order.refund_pending? %>
    <p class="mt-4 rounded-xl border border-yellow-900 bg-yellow-950/30 text-sm text-yellow-300 p-4">
      Full refund requested. Waiting for Stripe to confirm it.
    </p>
  <% elsif @order.refund_failed? %>
    <p class="mt-4 rounded-xl border border-red-900 bg-red-950/30 text-sm text-red-300 p-4">
      Stripe could not complete this refund. Contact SceneCore support before trying another refund.
    </p>
  <% elsif policy(@order).refund? %>
    <div class="mt-6 pt-6 border-t border-neutral-800">
      <%= button_to "Issue full refund", refund_band_order_path(@band, @order), method: :patch,
            form: { data: { turbo_confirm: "Refund the full amount, including shipping? This also reverses the band's payout and SceneCore's commission." } },
            class: "rounded-full border border-red-900 text-red-400 font-semibold px-6 py-3 hover:bg-red-950/40 transition cursor-pointer" %>
      <p class="text-xs text-neutral-500 mt-2">Stock is not restored automatically.</p>
    </div>
  <% end %>
</section>
