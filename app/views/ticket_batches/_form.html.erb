<%= form_with model: [ band, event, ticket_batch ], class: "flex flex-col gap-5" do |form| %>
  <% if ticket_batch.errors.any? %>
    <div class="rounded-xl border border-red-900/60 bg-red-950/30 p-4 text-sm text-red-300">
      <% ticket_batch.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Batch name", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_field :name, required: true, placeholder: "General admission", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <%= form.label :price_cents, "Price (USD cents)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.number_field :price_cents, required: true, min: 0, step: 1, placeholder: "2500", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      <p class="text-xs text-neutral-500 mt-1">Example: 2500 = US$25.00.</p>
    </div>
    <div>
      <%= form.label :quantity_total, "Tickets available", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.number_field :quantity_total, required: true, min: 1, step: 1, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
  </div>

  <fieldset class="rounded-xl border border-neutral-800 p-4">
    <legend class="px-2 text-sm font-semibold text-white">Member early access</legend>
    <p class="text-xs text-neutral-500 mb-4">Optional presale dates. Core Member must open first, followed by Supporter, Fan, and the public sale.</p>
    <div class="grid sm:grid-cols-3 gap-4">
      <div>
        <%= form.label :core_member_sales_start_at, "Core Member", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.datetime_local_field :core_member_sales_start_at, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>
      <div>
        <%= form.label :supporter_sales_start_at, "Supporter", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.datetime_local_field :supporter_sales_start_at, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>
      <div>
        <%= form.label :fan_sales_start_at, "Fan", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.datetime_local_field :fan_sales_start_at, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>
    </div>
  </fieldset>

  <div class="grid sm:grid-cols-2 gap-5">
    <div>
      <%= form.label :sales_start_at, "Sales start (optional)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.datetime_local_field :sales_start_at, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
    <div>
      <%= form.label :sales_end_at, "Sales end (optional)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.datetime_local_field :sales_end_at, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
  </div>

  <%= form.submit submit_label, class: "self-start rounded-full bg-yellow-400 text-black font-semibold px-6 py-2.5 hover:bg-yellow-300 transition cursor-pointer" %>
<% end %>
