<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "SceneCore" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Scenecore">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= render "shared/google_analytics" %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-black text-white min-h-screen flex flex-col">
    <header class="border-b border-neutral-800 bg-black/95 backdrop-blur sticky top-0 z-50" data-controller="mobile-menu">
      <div class="max-w-[100rem] mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <%= link_to root_path, class: "shrink-0" do %>
          <%= image_tag "logo.png", alt: "SceneCore", class: "h-[3.9rem] w-auto" %>
        <% end %>

        <%# One desktop navigation surface keeps primary and account actions
            together. Normal flex positioning prevents the account controls
            from overlapping the centred links on busy signed-in states. %>
        <nav id="desktop-nav" class="hidden xl:flex min-w-0 items-center gap-1 rounded-full border border-neutral-800 bg-neutral-900/80 px-1.5 py-1.5">
          <%= nav_pill_link "Home", root_path, current: current_page?(root_path), icon: :home %>
          <%= nav_pill_link "Bands", discover_bands_path, current: current_page?(discover_bands_path), icon: :bands %>
          <%= nav_pill_link "About", about_path, current: current_page?(about_path), icon: :about %>
          <%= nav_pill_link "How it works", how_it_works_path, current: current_page?(how_it_works_path), icon: :how_it_works %>
          <% if user_signed_in? %>
            <%= nav_pill_link "Your bands", bands_path, current: current_page?(bands_path), icon: :your_bands %>
            <% if current_user.platform_admin? %>
              <%= nav_pill_link "Admin", admin_root_path, current: request.path.start_with?("/admin"), icon: :admin %>
            <% end %>
            <span class="mx-1 h-6 w-px bg-neutral-700" aria-hidden="true"></span>
            <%= link_to profile_path, class: "flex items-center gap-2 rounded-full px-1.5 py-1 hover:bg-neutral-800 transition", "aria-label": "Profile" do %>
              <span class="h-8 w-8 rounded-full bg-yellow-400 text-black text-sm font-bold flex items-center justify-center shrink-0">
                <%= current_user.name.first.upcase %>
              </span>
              <span class="hidden 2xl:block text-sm font-medium text-neutral-200 max-w-20 truncate"><%= current_user.name %></span>
            <% end %>
            <%= link_to cart_path, class: "flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium text-neutral-300 hover:text-white hover:bg-neutral-800 transition", "aria-label": "Your cart" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
                <circle cx="9" cy="20" r="1.5" />
                <circle cx="18" cy="20" r="1.5" />
                <path d="M3 4h2l2.4 11h11L21 7H6" />
              </svg>
              <% count = current_user.carts.find_by(status: :active)&.cart_items&.sum(:quantity).to_i %>
              <% if count.positive? %>
                <span class="text-xs font-semibold text-yellow-300"><%= count %></span>
              <% end %>
            <% end %>
            <%= nav_pill_link "Tickets", tickets_path, current: request.path.start_with?("/tickets") %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-1.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer whitespace-nowrap" %>
          <% else %>
            <span class="mx-1 h-6 w-px bg-neutral-700" aria-hidden="true"></span>
            <%= link_to "Sign in", new_user_session_path, class: "rounded-full px-4 py-1.5 text-sm font-medium text-neutral-300 hover:text-white hover:bg-neutral-800 transition whitespace-nowrap" %>
            <%= link_to "Join Now", new_user_registration_path, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-1.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition whitespace-nowrap" %>
          <% end %>

          <%= link_to search_path, class: "h-9 w-9 rounded-full flex shrink-0 items-center justify-center text-neutral-300 hover:text-white hover:bg-neutral-800 transition", "aria-label": "Search" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4">
              <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            </svg>
          <% end %>
        </nav>

        <div class="flex items-center">
          <%# Below xl the compact menu owns all navigation and account
              actions, so the desktop bar can never wrap over the logo. %>
          <button
            type="button"
            class="xl:hidden h-9 w-9 flex items-center justify-center text-neutral-300 hover:text-white"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            data-mobile-menu-target="button"
            data-action="mobile-menu#toggle"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </div>
      </div>

      <div id="mobile-menu-panel" data-mobile-menu-target="panel" class="hidden xl:hidden border-t border-neutral-800 px-4 py-4 flex flex-col gap-4">
        <%= form_with url: search_path, method: :get, class: "flex items-center gap-2" do |form| %>
          <%= form.select :type, [ [ "Band", "band" ], [ "Album", "album" ] ], { selected: params[:type] }, class: "rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
          <%= form.text_field :q, value: params[:q], placeholder: "Search...", class: "flex-1 rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        <% end %>

        <nav class="flex flex-col gap-3">
          <%= link_to "Home", root_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
          <%= link_to "Bands", discover_bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
          <%= link_to "About", about_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
          <%= link_to "How it works", how_it_works_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>

          <% if user_signed_in? %>
            <%= link_to "Your bands", bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <% if current_user.platform_admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <% end %>
            <%= link_to "Profile", profile_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= link_to "Cart", cart_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= link_to "Tickets", tickets_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-left rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= link_to "Join Now", new_user_registration_path, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition text-center" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-yellow-400 text-sm text-center py-2 px-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-red-400 text-sm text-center py-2 px-4"><%= alert %></p>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
    <%= render "shared/cookie_consent" if ENV["GOOGLE_ANALYTICS_ID"].present? %>
  </body>
</html>
