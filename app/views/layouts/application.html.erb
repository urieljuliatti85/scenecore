<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Scenecore" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Scenecore">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-black text-white min-h-screen flex flex-col">
    <header class="border-b border-neutral-800 bg-black/95 backdrop-blur sticky top-0 z-50" data-controller="mobile-menu">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <%= link_to root_path, class: "shrink-0" do %>
          <%= image_tag "logo.png", alt: "SceneCore", class: "h-[3.9rem] w-auto" %>
        <% end %>

        <%= form_with url: search_path, method: :get, class: "hidden md:flex items-center gap-2 flex-1 max-w-md" do |form| %>
          <%= form.select :type, [ [ "Band", "band" ], [ "Album", "album" ] ], { selected: params[:type] }, class: "rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
          <%= form.text_field :q, value: params[:q], placeholder: "Search...", class: "flex-1 rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        <% end %>

        <nav id="desktop-nav" class="flex items-center gap-3 sm:gap-4">
          <%= link_to "Bands", discover_bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>

          <% if user_signed_in? %>
            <%= link_to "Your bands", bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>
            <% if current_user.platform_admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>
            <% end %>
            <%= link_to profile_path, class: "h-9 w-9 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-300 hover:text-white hover:border-neutral-500 transition hidden sm:flex", "aria-label": "Profile" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12Zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2V19.2c0-3.2-6.4-4.8-9.6-4.8Z" />
              </svg>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 sm:px-5 hover:bg-yellow-300 transition hidden sm:inline-block" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>
            <%= link_to "Join Now", new_user_registration_path, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 sm:px-5 hover:bg-yellow-300 transition hidden sm:inline-block" %>
          <% end %>

          <button
            type="button"
            class="sm:hidden h-9 w-9 flex items-center justify-center text-neutral-300 hover:text-white"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu-panel"
            data-mobile-menu-target="button"
            data-action="mobile-menu#toggle"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </button>
        </nav>
      </div>

      <div id="mobile-menu-panel" data-mobile-menu-target="panel" class="hidden sm:hidden border-t border-neutral-800 px-4 py-4 flex flex-col gap-4">
        <%= form_with url: search_path, method: :get, class: "flex items-center gap-2" do |form| %>
          <%= form.select :type, [ [ "Band", "band" ], [ "Album", "album" ] ], { selected: params[:type] }, class: "rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
          <%= form.text_field :q, value: params[:q], placeholder: "Search...", class: "flex-1 rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        <% end %>

        <nav class="flex flex-col gap-3">
          <%= link_to "Bands", discover_bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>

          <% if user_signed_in? %>
            <%= link_to "Your bands", bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <% if current_user.platform_admin? %>
              <%= link_to "Admin", admin_root_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <% end %>
            <%= link_to "Profile", profile_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "text-left rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 hover:bg-yellow-300 transition" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= link_to "Join Now", new_user_registration_path, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 hover:bg-yellow-300 transition text-center" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-yellow-400 text-sm text-center py-2 px-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-red-400 text-sm text-center py-2 px-4"><%= alert %></p>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
