<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Scenecore" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Scenecore">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-black text-white min-h-screen flex flex-col">
    <header class="border-b border-neutral-800 bg-black/95 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
        <%= link_to root_path, class: "shrink-0" do %>
          <%= image_tag "logo.png", alt: "SceneCore", class: "h-8 w-auto" %>
        <% end %>

        <nav class="flex items-center gap-3 sm:gap-4">
          <%= link_to "Bands", discover_bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>

          <% if user_signed_in? %>
            <%= link_to "Your bands", bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>
            <% if current_user.platform_admin? %>
              <%= link_to "Admin", admin_bands_path, class: "text-sm font-medium text-neutral-300 hover:text-white hidden sm:inline" %>
            <% end %>
            <%= link_to profile_path, class: "h-9 w-9 rounded-full border border-neutral-700 flex items-center justify-center text-neutral-300 hover:text-white hover:border-neutral-500 transition", "aria-label": "Profile" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12Zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2V19.2c0-3.2-6.4-4.8-9.6-4.8Z" />
              </svg>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 sm:px-5 hover:bg-yellow-300 transition" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-neutral-300 hover:text-white" %>
            <%= link_to "Join Now", new_user_registration_path, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 sm:px-5 hover:bg-yellow-300 transition" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-yellow-400 text-sm text-center py-2 px-4"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="bg-neutral-900 border-b border-neutral-800 text-red-400 text-sm text-center py-2 px-4"><%= alert %></p>
    <% end %>

    <main class="flex-1">
      <%= yield %>
    </main>
  </body>
</html>
