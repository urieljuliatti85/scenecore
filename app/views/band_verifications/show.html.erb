<section class="px-4 sm:px-6 py-16 max-w-lg mx-auto text-center">
  <h1 class="text-2xl font-extrabold tracking-tight text-white">Band verified</h1>
  <p class="text-neutral-400 mt-3">
    <%= @band.name %> is now a Verified Band on SceneCore.
  </p>
  <%= link_to "View #{@band.name}'s page", public_band_path(@band.slug), class: "mt-6 inline-block rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
</section>
