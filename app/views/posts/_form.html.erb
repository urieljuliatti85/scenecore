<%= form_with model: [ band, post ], class: "flex flex-col gap-5" do |form| %>
  <% if post.errors.any? %>
    <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
      <% post.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_field :title, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :body, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.rich_text_area :body,
          class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white",
          data: {
            direct_upload_url: post_direct_uploads_path,
            blob_url_template: rails_authenticated_service_blob_url(":signed_id", ":filename")
          } %>
  </div>

  <div>
    <%= form.label :post_type, "Type", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.select :post_type, Post.post_types.keys.map { |t| [ t.humanize, t ] }, {}, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :visibility, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.select :visibility, Post.visibilities.keys.map { |v| [ v.humanize, v ] }, {}, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :image, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 mb-1">PNG, JPEG or WebP, up to 5MB</p>
    <% if post.image.attached? && post.image.persisted? %>
      <%= image_tag post.image, class: "w-32 h-32 object-cover rounded-lg mb-2" %>
    <% end %>
    <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "w-full text-sm text-neutral-300 file:mr-4 file:rounded-full file:border-0 file:bg-yellow-400 file:text-black file:font-semibold file:px-4 file:py-2 file:cursor-pointer" %>
  </div>

  <div>
    <%= form.label :attachments, "Composition files", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 mb-1">Demos, rehearsal recordings, or lyrics. WAV, MP3, or PDF, up to 25MB each.</p>
    <% if post.attachments.attached? %>
      <ul class="text-sm text-neutral-400 mb-2 space-y-1">
        <% post.attachments.each do |attachment| %>
          <li><%= attachment.filename %></li>
        <% end %>
      </ul>
    <% end %>
    <%= form.file_field :attachments, multiple: true, accept: "audio/wav,audio/mpeg,application/pdf", class: "w-full text-sm text-neutral-300 file:mr-4 file:rounded-full file:border-0 file:bg-yellow-400 file:text-black file:font-semibold file:px-4 file:py-2 file:cursor-pointer" %>
  </div>

  <%= form.submit submit_label, class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start" %>
<% end %>
