  <div class="mt-4">
    <h3 class="text-lg font-semibold text-neutral-300 mb-4">Albums</h3>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      <% @albums.each do |album| %>
        <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
          <%= link_to band_album_path(@band, album), class: "block" do %>
            <div class="aspect-square bg-neutral-800 flex items-center justify-center">
              <% if album.cover_url.present? %>
                <%= image_tag album.cover_url, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
              <% else %>
                <span class="text-neutral-600 text-sm">No cover</span>
              <% end %>
            </div>
            <div class="p-4">
              <p class="font-semibold text-white group-hover:text-yellow-400 transition"><%= album.title %></p>
              <p class="text-sm text-neutral-500 uppercase tracking-wide"><%= album.status %></p>
            </div>
          <% end %>

          <div class="px-4 pb-4 flex flex-wrap items-center gap-2">
            <% if policy(album).publish? && album.draft? %>
              <%= button_to "Publish", publish_band_album_path(@band, album), method: :patch, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-xs font-semibold px-3 py-1.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
            <% end %>

            <% if policy(album).unpublish? && album.published? %>
              <%= button_to "Unpublish", unpublish_band_album_path(@band, album), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
            <% end %>

            <% if policy(album).update? %>
              <%= link_to "Edit", edit_band_album_path(@band, album), class: "text-xs text-neutral-400 hover:text-white transition" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
