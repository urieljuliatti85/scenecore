<%# Orders the band still owes goods on come first — that is the work to do.
    Everything else stays below as a record of what has sold. %>
<div class="flex flex-col gap-8">
  <div>
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <h3 class="text-sm font-semibold text-white">To fulfil</h3>
      <% if orders_awaiting.any? %>
        <span class="text-xs text-neutral-600"><%= pluralize(orders_awaiting.size, "order") %></span>
      <% end %>
    </div>

    <% if orders_awaiting.empty? %>
      <p class="text-sm text-neutral-500">Nothing waiting to be sent.</p>
    <% else %>
      <ul class="flex flex-col gap-3">
        <% orders_awaiting.each do |order| %>
          <%= render "bands/order_row", band: band, order: order, fulfilling: true %>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if orders_settled.any? %>
    <div class="pt-6 border-t border-neutral-800">
      <h3 class="text-sm font-semibold text-white mb-4">Everything else</h3>

      <ul class="flex flex-col gap-3">
        <% orders_settled.each do |order| %>
          <%= render "bands/order_row", band: band, order: order, fulfilling: false %>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
