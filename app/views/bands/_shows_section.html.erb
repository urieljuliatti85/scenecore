  <div class="mt-6">
    <h3 class="text-lg font-semibold text-neutral-300 mb-4">Shows</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% @events.each do |event| %>
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
          <%= link_to band_event_path(@band, event), class: "block px-5 py-4" do %>
            <p class="font-semibold text-white"><%= event.title %></p>
            <p class="text-sm text-neutral-400 mt-1"><%= event.starts_at.strftime("%d %b %Y · %H:%M") %> · <%= event.location %></p>
            <p class="text-xs uppercase tracking-wide text-neutral-500 mt-1"><%= event.status %></p>
          <% end %>

          <div class="px-5 pb-4 flex flex-wrap items-center gap-2">
            <% if policy(event).publish? && event.draft? %>
              <%= button_to "Publish", publish_band_event_path(@band, event), method: :patch, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-xs font-semibold px-3 py-1.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
            <% end %>

            <% if policy(event).unpublish? && event.published? %>
              <%= button_to "Unpublish", unpublish_band_event_path(@band, event), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
            <% end %>

            <%= link_to "Edit", edit_band_event_path(@band, event), class: "text-xs text-neutral-400 hover:text-white transition" %>
            <%= button_to "Delete", band_event_path(@band, event), method: :delete, class: "text-xs text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this event?" } } %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
