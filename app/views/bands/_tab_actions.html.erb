<%# The actions for a tab sit above its content rather than in one long row
    at the top of the page, so each one appears next to the thing it acts
    on. The first is the primary action for that tab. %>
<div class="flex flex-wrap items-center gap-3 mb-6">
  <% actions.each do |label, path, primary| %>
    <%= link_to label, path, class: "rounded-full text-sm font-semibold px-5 py-2.5 transition #{primary ? "bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 hover:bg-yellow-400/20 hover:text-yellow-200" : "border border-neutral-700 text-white hover:border-neutral-500"}" %>
  <% end %>
</div>
