<%# One order in the band's list. The shipping address is the reason this
    row exists, so it is shown inline for orders being fulfilled rather
    than hidden behind a click. %>
<li class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-3">
        <%= link_to "Order ##{order.id}", band_order_path(band, order), class: "font-semibold text-white hover:text-yellow-300 transition" %>
        <%= render "orders/status_badge", order: order %>
      </div>

      <p class="text-sm text-neutral-500 mt-1">
        <%= order.created_at.strftime("%d %b %Y") %> ·
        <%= pluralize(order.order_items.sum(&:quantity), "item") %> ·
        <%= number_to_currency(order.total_cents / 100.0) %>
      </p>

      <ul class="mt-3 flex flex-col gap-1 text-sm text-neutral-300">
        <% order.order_items.each do |item| %>
          <li>
            <%= item.quantity %>&times; <%= item.product_name %>
            <span class="text-neutral-500">(<%= item.variant_name %>)</span>
          </li>
        <% end %>
      </ul>
    </div>

    <% if fulfilling && policy(order).fulfil? %>
      <%= button_to "Mark #{order.next_fulfilment_status}", fulfil_band_order_path(band, order), method: :patch,
            class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer whitespace-nowrap shrink-0" %>
    <% end %>
  </div>

  <% if fulfilling && order.shipping_address %>
    <div class="mt-4 pt-4 border-t border-neutral-800">
      <p class="text-xs uppercase tracking-wide text-neutral-600 mb-2">Ship to</p>
      <address class="text-sm text-neutral-300 not-italic leading-relaxed">
        <%= order.shipping_address.recipient_name %><br>
        <%= order.shipping_address.line1 %><br>
        <% if order.shipping_address.line2.present? %>
          <%= order.shipping_address.line2 %><br>
        <% end %>
        <%= order.shipping_address.city %>, <%= order.shipping_address.state %>
        <%= order.shipping_address.postal_code %><br>
        <%= order.shipping_address.country %>
      </address>
    </div>
  <% end %>
</li>
