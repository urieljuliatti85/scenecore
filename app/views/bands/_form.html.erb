<%= form_with model: band, class: "flex flex-col gap-5",
              data: band.new_record? ? { controller: "band-search", "band-search-url-value": search_bands_path } : {} do |form| %>
  <% if band.errors.any? %>
    <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
      <% band.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <%# Only when signing a band up: on edit the details are already set, and
      re-running a lookup would just risk overwriting them. %>
  <% if band.new_record? %>
    <div class="rounded-xl border border-neutral-800 bg-neutral-900/40 p-4 flex flex-col gap-2">
      <label for="spotify_artist_query" class="block text-sm font-medium text-neutral-300">Find your band on Spotify (optional)</label>
      <p class="text-xs text-neutral-500">Fills in the name, Spotify link and photo below. You can edit anything afterwards.</p>
      <input type="text" id="spotify_artist_query" autocomplete="off" placeholder="Search by artist name"
             data-band-search-target="query" data-action="input->band-search#search"
             class="w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400">
      <ul data-band-search-target="results" class="text-sm text-neutral-300 empty:hidden"></ul>

      <div data-band-search-target="preview" hidden class="flex items-center gap-3 border-t border-neutral-800 pt-3">
        <img data-band-search-target="previewImage" src="" alt="" class="w-12 h-12 rounded object-cover">
        <span class="text-sm text-neutral-300 flex-1">Photo from <span data-band-search-target="previewName"></span></span>
        <button type="button" data-action="band-search#clearPhoto" class="text-xs text-neutral-400 hover:text-white underline cursor-pointer">Remove</button>
      </div>

      <%= hidden_field_tag :spotify_image_url, nil, data: { "band-search-target": "imageUrl" } %>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_field :name, data: { "band-search-target": "name" }, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_area :description, rows: 4, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :category_id, "Category", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.select :category_id, category_select_options, { include_blank: "No category" }, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :photo, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <p class="text-xs text-neutral-500 mb-1">PNG, JPEG or WebP, up to 5MB</p>
    <% if band.photo.attached? && band.photo.persisted? %>
      <%= image_tag band.photo, class: "w-32 h-32 object-cover rounded-lg mb-2" %>
    <% end %>
    <%= form.file_field :photo, accept: "image/png,image/jpeg,image/webp", class: "w-full text-sm text-neutral-300 file:mr-4 file:rounded-full file:border-0 file:bg-yellow-400 file:text-black file:font-semibold file:px-4 file:py-2 file:cursor-pointer" %>
  </div>

  <fieldset class="flex flex-col gap-4 border border-neutral-800 rounded-xl p-4">
    <legend class="text-sm font-medium text-neutral-300 px-1">Social links (optional)</legend>

    <div>
      <%= form.label :spotify_url, "Spotify", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.url_field :spotify_url, placeholder: "https://open.spotify.com/...", data: { "band-search-target": "spotifyUrl" }, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :youtube_url, "YouTube", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.url_field :youtube_url, placeholder: "https://youtube.com/...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :instagram_url, "Instagram", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.url_field :instagram_url, placeholder: "https://instagram.com/...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :bandcamp_url, "Bandcamp", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.url_field :bandcamp_url, placeholder: "https://yourband.bandcamp.com/...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :website_url, "Website", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.url_field :website_url, placeholder: "https://...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>
  </fieldset>

  <%= form.submit class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start" %>
<% end %>
