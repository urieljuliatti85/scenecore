<%# One item in the panel's sidebar. `flagged` marks a section that needs
    attention even when it is not the active one — Payments uses it while
    the band cannot take money, since nothing else on the page says so.

    The count sits hard right on the sidebar (ml-auto) so the numbers line
    up in a column; in the horizontal phone layout it just follows the
    label. %>
<% active = slug == current_tab %>
<% flagged = local_assigns.fetch(:flagged, false) %>

<%= link_to band_path(band, tab: slug),
      aria: { current: ("page" if active) },
      class: "flex items-center gap-2 rounded-lg px-3.5 py-2.5 font-mono text-xs uppercase tracking-wider transition whitespace-nowrap #{active || flagged ? "bg-yellow-400/10 text-yellow-300 border border-yellow-500/30" : "border border-transparent text-neutral-400 hover:text-white hover:bg-neutral-900"}" do %>
  <% if flagged && !active %>
    <span class="h-1.5 w-1.5 rounded-full bg-yellow-400 shrink-0" aria-hidden="true"></span>
  <% else %>
    <%= render "bands/tab_icon", slug: slug %>
  <% end %>
  <span><%= label %></span>
  <% if count&.positive? %>
    <span class="lg:ml-auto <%= active ? "text-yellow-500/70" : "text-neutral-600" %>"><%= count %></span>
  <% end %>
<% end %>
