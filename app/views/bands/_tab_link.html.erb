<%# One pill in the panel's tab bar. `flagged` marks a tab that needs
    attention even when it is not the active one — Payments uses it while
    the band cannot take money, since nothing else on the page says so. %>
<% active = slug == current_tab %>
<% flagged = local_assigns.fetch(:flagged, false) %>

<%= link_to band_path(band, tab: slug),
      aria: { current: ("page" if active) },
      class: "flex items-center gap-2 rounded-lg px-3.5 py-2 font-mono text-xs uppercase tracking-wider transition #{active || flagged ? "bg-yellow-400/10 text-yellow-300 border border-yellow-500/30" : "border border-transparent text-neutral-400 hover:text-white"}" do %>
  <% if flagged && !active %>
    <span class="h-1.5 w-1.5 rounded-full bg-yellow-400 shrink-0" aria-hidden="true"></span>
  <% else %>
    <%= render "bands/tab_icon", slug: slug %>
  <% end %>
  <span><%= label %></span>
  <% if count&.positive? %>
    <span class="<%= active ? "text-yellow-500/70" : "text-neutral-600" %>"><%= count %></span>
  <% end %>
<% end %>
