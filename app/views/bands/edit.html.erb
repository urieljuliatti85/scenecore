<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-xl mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-8">Edit band</h1>

  <%= render "form", band: @band %>

  <div class="mt-10 pt-8 border-t border-neutral-800">
    <h2 class="text-sm font-semibold text-neutral-300 mb-1">Merch discounts</h2>
    <p class="text-xs text-neutral-500 mb-4">
      Discount percentage by membership level. There's no store yet to apply these to — this just sets
      the rule for when one exists.
    </p>

    <%= form_with url: band_merch_discounts_path(@band), method: :patch, scope: :merch_discounts, class: "flex flex-col gap-4" do |form| %>
      <% Membership::LEVELS.each do |level| %>
        <div>
          <%= form.label level, level.humanize, class: "block text-sm font-medium text-neutral-300 mb-1" %>
          <div class="flex items-center gap-2">
            <%= form.number_field level, min: 0, max: 100, value: @band.merch_discounts.find { |d| d.level == level }&.percentage || 0, class: "w-24 rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
            <span class="text-sm text-neutral-500">%</span>
          </div>
        </div>
      <% end %>

      <%= form.submit "Save discounts", class: "rounded-full border border-neutral-700 text-white font-semibold px-6 py-3 hover:border-neutral-500 transition cursor-pointer self-start" %>
    <% end %>
  </div>
</section>
