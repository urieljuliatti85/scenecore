    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-4">
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Fans</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["fan"] %></span>
        <% if @total_active_members.positive? %>
          <span class="text-xs text-neutral-500"><%= number_to_percentage(100.0 * @membership_counts["fan"] / @total_active_members, precision: 0) %></span>
        <% end %>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Supporters</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["supporter"] %></span>
        <% if @total_active_members.positive? %>
          <span class="text-xs text-neutral-500"><%= number_to_percentage(100.0 * @membership_counts["supporter"] / @total_active_members, precision: 0) %></span>
        <% end %>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Core Members</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["core_member"] %></span>
        <% if @total_active_members.positive? %>
          <span class="text-xs text-neutral-500"><%= number_to_percentage(100.0 * @membership_counts["core_member"] / @total_active_members, precision: 0) %></span>
        <% end %>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">New this month</span>
        <span class="text-xl font-bold text-white"><%= @new_members_this_month %></span>
      </div>
    </div>

    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1 mb-4 max-w-xs">
      <span class="text-xs uppercase tracking-wide text-neutral-500">Estimated monthly revenue</span>
      <span class="text-xl font-bold text-white"><%= number_to_currency(@monthly_recurring_revenue_cents / 100.0) %></span>
      <span class="text-xs text-neutral-600">Based on current plan prices — not reconciled with Stripe</span>
    </div>

    <div class="mb-8">
      <h3 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-2">New members, last 6 months</h3>
      <div class="flex items-end gap-2 h-20">
        <% max_count = [ @new_members_by_month.values.max, 1 ].max %>
        <% @new_members_by_month.each do |month, count| %>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-yellow-400/70 rounded-t" style="height: <%= (count.to_f / max_count * 100).round %>%"></div>
            <span class="text-[10px] text-neutral-500"><%= month.strftime("%b") %></span>
            <span class="text-[10px] text-neutral-600"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>
