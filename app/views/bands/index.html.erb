<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight">Your bands</h1>
    <%= link_to "New band", new_band_path, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
  </div>

  <% if @bands.empty? %>
    <p class="text-neutral-500">You don't belong to any band yet.</p>
  <% else %>
    <ul class="space-y-3">
      <% @bands.each do |band| %>
        <li class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex items-center justify-between gap-4">
          <div class="min-w-0">
            <%= link_to band.name, band, class: "font-semibold text-white hover:text-yellow-400" %>
            <% if policy(band).update? %>
              <div class="mt-2">
                <%= link_to "Products", band_products_path(band), class: "text-sm text-neutral-400 hover:text-white transition" %>
              </div>
            <% end %>
          </div>
          <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-3 py-1"><%= band.status %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
