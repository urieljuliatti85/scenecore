<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-4">
    <h1 class="text-3xl font-extrabold tracking-tight"><%= @band.name %></h1>
    <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-3 py-1"><%= @band.status %></span>
  </div>

  <% if @band.description.present? %>
    <p class="text-neutral-300 mb-8"><%= @band.description %></p>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(@band).show? %>
      <%= link_to "Add Album", new_band_album_path(@band), class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition" %>
      <%= link_to "New Post", new_band_post_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
    <% end %>

    <% if policy(@band).update? %>
      <%= link_to "Edit", edit_band_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "Members", band_band_memberships_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
    <% end %>

    <% if policy(@band).approve? && @band.pending? %>
      <%= button_to "Approve", approve_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition cursor-pointer" %>
      <%= button_to "Reject", reject_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
    <% end %>

    <% if policy(@band).suspend? && @band.approved? %>
      <%= button_to "Suspend", suspend_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
    <% end %>

    <% if policy(@band).reactivate? && @band.suspended? %>
      <%= button_to "Reactivate", reactivate_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition cursor-pointer" %>
    <% end %>
  </div>

  <% if policy(@band).show? && @band.albums.any? %>
    <div class="mt-10 flex flex-col gap-8">
      <% @band.albums.includes(:tracks).each do |album| %>
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <h2 class="text-lg font-semibold text-neutral-300">
              <%= album.title %>
              <span class="text-xs uppercase tracking-wide text-neutral-500 ml-2"><%= album.status %></span>
            </h2>

            <% if policy(album).publish? && album.draft? %>
              <%= button_to "Publish", publish_band_album_path(@band, album), method: :patch, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
            <% end %>

            <% if policy(album).unpublish? && album.published? %>
              <%= button_to "Unpublish", unpublish_band_album_path(@band, album), method: :patch, class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
            <% end %>

            <% if policy(album).update? %>
              <%= link_to "Edit", edit_band_album_path(@band, album), class: "text-sm text-neutral-400 hover:text-white transition" %>
            <% end %>
          </div>
          <ul class="flex flex-col gap-2">
            <% album.tracks.order(:track_number).each do |track| %>
              <li class="flex items-center justify-between gap-3 rounded-lg border border-neutral-800 px-4 py-3">
                <div>
                  <span class="text-neutral-500 text-sm mr-2"><%= track.track_number %></span>
                  <span class="text-white"><%= track.title %></span>
                  <span class="text-xs uppercase tracking-wide text-neutral-500 ml-2"><%= track.status %></span>
                </div>
                <%= link_to "Edit", edit_band_track_path(@band, track), class: "text-sm text-neutral-400 hover:text-white transition" %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if policy(@band).show? && @band.posts.any? %>
    <div class="mt-10 flex flex-col gap-4">
      <h2 class="text-lg font-semibold text-neutral-300">Posts</h2>
      <% @band.posts.order(created_at: :desc).each do |post| %>
        <div class="rounded-lg border border-neutral-800 px-4 py-3">
          <div class="flex flex-wrap items-center gap-3 mb-2">
            <span class="text-white font-medium"><%= post.title %></span>
            <span class="text-xs uppercase tracking-wide text-neutral-500"><%= post.status %></span>
            <span class="text-xs uppercase tracking-wide text-neutral-500"><%= post.visibility %></span>

            <% if policy(post).publish? && post.draft? %>
              <%= button_to "Publish", publish_band_post_path(@band, post), method: :patch, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
            <% end %>

            <% if policy(post).unpublish? && post.published? %>
              <%= button_to "Unpublish", unpublish_band_post_path(@band, post), method: :patch, class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
            <% end %>

            <%= link_to "Edit", edit_band_post_path(@band, post), class: "text-sm text-neutral-400 hover:text-white transition" %>
            <%= button_to "Delete", band_post_path(@band, post), method: :delete, class: "text-sm text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this post?" } } %>
          </div>
          <p class="text-neutral-300 text-sm"><%= post.body %></p>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
