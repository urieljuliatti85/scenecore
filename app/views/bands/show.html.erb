<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <div class="flex items-center gap-3 mb-4">
    <h1 class="text-3xl font-extrabold tracking-tight"><%= @band.name %></h1>
    <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-3 py-1"><%= @band.status %></span>
  </div>

  <% if @band.description.present? %>
    <p class="text-neutral-300 mb-8"><%= @band.description %></p>
  <% end %>

  <% if @membership_counts %>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8">
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Fans</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["fan"] %></span>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Supporters</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["supporter"] %></span>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">Core Members</span>
        <span class="text-xl font-bold text-white"><%= @membership_counts["core_member"] %></span>
      </div>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col gap-1">
        <span class="text-xs uppercase tracking-wide text-neutral-500">New this month</span>
        <span class="text-xl font-bold text-white"><%= @new_members_this_month %></span>
      </div>
    </div>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(@band).show? %>
      <%= link_to "Add Album", new_band_album_path(@band), class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition" %>
      <%= link_to "New Post", new_band_post_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "Add Event", new_band_event_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "New Poll", new_band_poll_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "New Core Session", new_band_core_session_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
    <% end %>

    <% if policy(@band).update? %>
      <%= link_to "Edit", edit_band_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "Members", band_band_memberships_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "Supporters", band_memberships_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
      <%= link_to "Messages", band_direct_message_threads_path(@band), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
    <% end %>

    <% if policy(@band).approve? && @band.pending? %>
      <%= button_to "Approve", approve_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition cursor-pointer" %>
      <%= button_to "Reject", reject_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
    <% end %>

    <% if policy(@band).suspend? && @band.approved? %>
      <%= button_to "Suspend", suspend_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
    <% end %>

    <% if policy(@band).reactivate? && @band.suspended? %>
      <%= button_to "Reactivate", reactivate_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400 text-black font-semibold px-5 py-2.5 hover:bg-yellow-300 transition cursor-pointer" %>
    <% end %>
  </div>

  <% if policy(@band).show? && (@albums.any? || @events.any? || @posts.any? || @polls.any? || @core_sessions.any?) %>
    <h2 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mt-10 mb-2">Content</h2>
  <% end %>

  <% if policy(@band).show? && @albums.any? %>
    <div class="mt-4">
      <h3 class="text-lg font-semibold text-neutral-300 mb-4">Albums</h3>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <% @albums.each do |album| %>
          <div class="group rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
            <%= link_to band_album_path(@band, album), class: "block" do %>
              <div class="aspect-square bg-neutral-800 flex items-center justify-center">
                <% if album.cover_url.present? %>
                  <%= image_tag album.cover_url, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
                <% else %>
                  <span class="text-neutral-600 text-sm">No cover</span>
                <% end %>
              </div>
              <div class="p-4">
                <p class="font-semibold text-white group-hover:text-yellow-400 transition"><%= album.title %></p>
                <p class="text-sm text-neutral-500 uppercase tracking-wide"><%= album.status %></p>
              </div>
            <% end %>

            <div class="px-4 pb-4 flex flex-wrap items-center gap-2">
              <% if policy(album).publish? && album.draft? %>
                <%= button_to "Publish", publish_band_album_path(@band, album), method: :patch, class: "rounded-full bg-yellow-400 text-black text-xs font-semibold px-3 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
              <% end %>

              <% if policy(album).unpublish? && album.published? %>
                <%= button_to "Unpublish", unpublish_band_album_path(@band, album), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
              <% end %>

              <% if policy(album).update? %>
                <%= link_to "Edit", edit_band_album_path(@band, album), class: "text-xs text-neutral-400 hover:text-white transition" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if policy(@band).show? && @events.any? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold text-neutral-300 mb-4">Shows</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @events.each do |event| %>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
            <%= link_to band_event_path(@band, event), class: "block px-5 py-4" do %>
              <p class="font-semibold text-white"><%= event.title %></p>
              <p class="text-sm text-neutral-400 mt-1"><%= event.starts_at.strftime("%d %b %Y · %H:%M") %> · <%= event.location %></p>
              <p class="text-xs uppercase tracking-wide text-neutral-500 mt-1"><%= event.status %></p>
            <% end %>

            <div class="px-5 pb-4 flex flex-wrap items-center gap-2">
              <% if policy(event).publish? && event.draft? %>
                <%= button_to "Publish", publish_band_event_path(@band, event), method: :patch, class: "rounded-full bg-yellow-400 text-black text-xs font-semibold px-3 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
              <% end %>

              <% if policy(event).unpublish? && event.published? %>
                <%= button_to "Unpublish", unpublish_band_event_path(@band, event), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
              <% end %>

              <%= link_to "Edit", edit_band_event_path(@band, event), class: "text-xs text-neutral-400 hover:text-white transition" %>
              <%= button_to "Delete", band_event_path(@band, event), method: :delete, class: "text-xs text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this event?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if policy(@band).show? && @posts.any? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold text-neutral-300 mb-4">Posts</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @posts.each do |post| %>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
            <%= link_to band_post_path(@band, post), class: "block px-5 py-4" do %>
              <p class="font-semibold text-white"><%= post.title %></p>
              <p class="text-xs uppercase tracking-wide text-neutral-500 mt-1">
                <%= post.status %> &middot; <%= post.visibility %>
              </p>
            <% end %>

            <div class="px-5 pb-4 flex flex-wrap items-center gap-2">
              <% if policy(post).publish? && post.draft? %>
                <%= button_to "Publish", publish_band_post_path(@band, post), method: :patch, class: "rounded-full bg-yellow-400 text-black text-xs font-semibold px-3 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
              <% end %>

              <% if policy(post).unpublish? && post.published? %>
                <%= button_to "Unpublish", unpublish_band_post_path(@band, post), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
              <% end %>

              <%= link_to "Edit", edit_band_post_path(@band, post), class: "text-xs text-neutral-400 hover:text-white transition" %>
              <%= button_to "Delete", band_post_path(@band, post), method: :delete, class: "text-xs text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this post?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if policy(@band).show? && @polls.any? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold text-neutral-300 mb-4">Polls</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @polls.each do |poll| %>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
            <%= link_to band_poll_path(@band, poll), class: "block px-5 py-4" do %>
              <p class="font-semibold text-white"><%= poll.question %></p>
              <p class="text-xs uppercase tracking-wide text-neutral-500 mt-1">
                <%= poll.status %> &middot; <%= poll.visibility %>
              </p>
            <% end %>

            <div class="px-5 pb-4 flex flex-wrap items-center gap-2">
              <% if policy(poll).publish? && poll.draft? %>
                <%= button_to "Publish", publish_band_poll_path(@band, poll), method: :patch, class: "rounded-full bg-yellow-400 text-black text-xs font-semibold px-3 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
              <% end %>

              <% if policy(poll).unpublish? && poll.published? %>
                <%= button_to "Unpublish", unpublish_band_poll_path(@band, poll), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
              <% end %>

              <%= link_to "Edit", edit_band_poll_path(@band, poll), class: "text-xs text-neutral-400 hover:text-white transition" %>
              <%= button_to "Delete", band_poll_path(@band, poll), method: :delete, class: "text-xs text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this poll?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if policy(@band).show? && @core_sessions.any? %>
    <div class="mt-6">
      <h3 class="text-lg font-semibold text-neutral-300 mb-4">Core Sessions</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <% @core_sessions.each do |core_session| %>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition">
            <%= link_to band_core_session_path(@band, core_session), class: "block px-5 py-4" do %>
              <p class="font-semibold text-white"><%= core_session.title %></p>
              <p class="text-sm text-neutral-400 mt-1"><%= core_session.starts_at.strftime("%d %b %Y · %H:%M") %></p>
              <p class="text-xs uppercase tracking-wide text-neutral-500 mt-1">
                <%= core_session.status %> &middot; <%= core_session.session_type.humanize %>
              </p>
            <% end %>

            <div class="px-5 pb-4 flex flex-wrap items-center gap-2">
              <% if policy(core_session).publish? && core_session.draft? %>
                <%= button_to "Publish", publish_band_core_session_path(@band, core_session), method: :patch, class: "rounded-full bg-yellow-400 text-black text-xs font-semibold px-3 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
              <% end %>

              <% if policy(core_session).unpublish? && core_session.published? %>
                <%= button_to "Unpublish", unpublish_band_core_session_path(@band, core_session), method: :patch, class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
              <% end %>

              <%= link_to "Edit", edit_band_core_session_path(@band, core_session), class: "text-xs text-neutral-400 hover:text-white transition" %>
              <%= button_to "Delete", band_core_session_path(@band, core_session), method: :delete, class: "text-xs text-red-400 hover:text-red-300 transition cursor-pointer", form: { data: { turbo_confirm: "Delete this core session?" } } %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</section>
