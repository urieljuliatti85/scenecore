<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-6xl mx-auto">
  <div class="flex items-center gap-3 mb-4">
    <h1 class="text-3xl font-extrabold tracking-tight"><%= @band.name %></h1>
    <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-3 py-1"><%= @band.status %></span>
  </div>

  <% if @band.description.present? %>
    <p class="text-neutral-300 mb-8"><%= @band.description %></p>
  <% end %>

  <%# Navigation on the left, the panel on the right — the sidebar keeps
      every section one click away instead of hiding them in a wrapped row
      of pills. It stacks above the content below lg, where a fixed column
      would leave the panel too narrow to read. %>
  <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
    <%= render "tabs", band: @band, current_tab: @tab, tabs: [
          [ "overview", "Overview", nil ],
          [ "music", "Music", @albums.size ],
          [ "posts", "Posts", @posts.size ],
          [ "shows", "Shows", @events.size ],
          [ "community", "Community", @polls.size + @core_sessions.size ]
        ], manage: (policy(@band).update? ? [
          [ "profile", "Profile", nil ],
          [ "members", "Members", nil ],
          [ "supporters", "Supporters", nil ],
          [ "products", "Products", nil ],
          [ "orders", "Orders", @band.orders.awaiting_band.size ],
          [ "payments", "Payments", nil ]
        ] : []) %>

    <div class="flex-1 min-w-0 rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 sm:p-8">
      <% case @tab %>
    <% when "music" %>
      <%= render "tab_actions", actions: [
            [ "Add album", new_band_album_path(@band), true ]
          ] %>
      <% if @albums.any? %>
        <%= render "albums_section" %>
      <% else %>
        <%= render "tab_empty", message: "No albums yet. Bring them over from Spotify or add one by hand." %>
      <% end %>

    <% when "posts" %>
      <%= render "tab_actions", actions: [
            [ "New post", new_band_post_path(@band), true ]
          ] %>
      <% if @posts.any? %>
        <%= render "posts_section" %>
      <% else %>
        <%= render "tab_empty", message: "No posts yet. This is where you write to the people following you." %>
      <% end %>

    <% when "shows" %>
      <%= render "tab_actions", actions: [
            [ "Add show", new_band_event_path(@band), true ]
          ] %>
      <% if @events.any? %>
        <%= render "shows_section" %>
      <% else %>
        <%= render "tab_empty", message: "No shows announced yet." %>
      <% end %>

    <% when "community" %>
      <%= render "tab_actions", actions: [
            [ "New poll", new_band_poll_path(@band), true ],
            [ "New core session", new_band_core_session_path(@band), false ],
            [ "Messages", band_direct_message_threads_path(@band), false ]
          ] %>
      <% if @polls.any? %>
        <%= render "polls_section" %>
      <% end %>
      <% if @core_sessions.any? %>
        <%= render "core_sessions_section" %>
      <% end %>
      <% if @polls.none? && @core_sessions.none? %>
        <%= render "tab_empty", message: "No polls or core sessions yet. Both are ways to bring members into what the band is doing." %>
      <% end %>

    <% when "profile" %>
      <%= render "tab_actions", actions: [
            [ "Edit band profile", edit_band_path(@band), true ]
          ] %>
      <%= render "profile_section", band: @band %>

    <% when "members" %>
      <%= render "tab_actions", actions: [
            [ "Add member", new_band_band_membership_path(@band), true ]
          ] %>
      <%= render "band_memberships/list", band: @band, memberships: @band_memberships %>

    <% when "supporters" %>
      <%= render "memberships/list", band: @band, memberships: @supporter_memberships %>

    <% when "products" %>
      <%= render "tab_actions", actions: [
            [ "New product", new_band_product_path(@band), true ],
            [ "Shipping", band_shipping_zones_path(@band), false ]
          ] %>
      <%= render "products/list", band: @band, products: @products %>

    <% when "orders" %>
      <%= render "orders_section", band: @band,
            orders_awaiting: @orders_awaiting, orders_settled: @orders_settled %>

    <% when "payments" %>
      <%= render "band_payments/panel", band: @band,
            active_subscribers: @active_subscribers, published_products: @published_products %>

    <% else %>
      <%= render "overview_section" %>

      <% end %>
    </div>
  </div>

  <%# Moderation belongs to a platform administrator, not to the band's own
      work, so it sits outside the tabs, in a row of its own rather than
      loose under the panel. %>
  <% if policy(@band).approve? || policy(@band).suspend? || policy(@band).feature? %>
    <div class="mt-6">
      <p class="text-xs uppercase tracking-wide text-neutral-600 mb-3">Platform moderation</p>
      <div class="flex flex-wrap items-center gap-3">
      <% if policy(@band).approve? && @band.pending? %>
        <%= button_to "Approve", approve_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
        <%= button_to "Reject", reject_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
      <% end %>

      <% if policy(@band).suspend? && @band.approved? %>
        <%= button_to "Suspend", suspend_band_path(@band), method: :patch, class: "rounded-full border border-red-900 text-red-400 font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
      <% end %>

      <% if policy(@band).reactivate? && @band.suspended? %>
        <%= button_to "Reactivate", reactivate_band_path(@band), method: :patch, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
      <% end %>

      <% if policy(@band).feature? && @band.approved? %>
      <% if @band.featured? %>
        <%= button_to "Unfeature", unfeature_band_path(@band), method: :patch, class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition cursor-pointer" %>
      <% else %>
        <%= button_to "Feature on home", feature_band_path(@band), method: :patch, class: "rounded-full border border-yellow-700 text-yellow-400 font-semibold px-5 py-2.5 hover:border-yellow-500 transition cursor-pointer" %>
      <% end %>
      <% end %>
      </div>
    </div>
  <% end %>

</section>
