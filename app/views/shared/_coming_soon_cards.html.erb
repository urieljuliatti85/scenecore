<%
  cards = [
    ["Music", "Albums, singles and more", band ? "#albums" : nil],
    ["Exclusive Content", "Behind the scenes, interviews, and more", nil],
    ["Subscriptions", "Support the band and get special perks", band ? public_band_subscriptions_path(band.slug) : nil],
    ["Posts", "News, updates and behind the scenes", band ? "#posts" : nil],
    ["Tickets", "Live shows and tour dates", nil]
  ]
%>
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
  <% cards.each do |title, description, href| %>
    <% if href %>
      <%= link_to href, class: "rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 flex flex-col gap-3 hover:border-neutral-600 transition" do %>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-white"><%= title %></span>
        </div>
        <p class="text-sm text-neutral-500"><%= description %></p>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 flex flex-col gap-3 opacity-60 cursor-not-allowed">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-white"><%= title %></span>
          <span class="text-[10px] uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-2 py-0.5">Soon</span>
        </div>
        <p class="text-sm text-neutral-500"><%= description %></p>
      </div>
    <% end %>
  <% end %>
</div>
