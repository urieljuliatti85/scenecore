<%
  # On a band's own page these anchor into that band's content. On the home
  # page there is no band in context and no global index for music or posts
  # — each band's page is where the content actually lives — so those cards
  # point at the band directory instead of staying dead. Cards for features
  # that do not exist yet keep their "Soon" badge rather than promising
  # something the platform cannot deliver.
  cards = [
    ["Music", "Albums, singles and more", band ? "#albums" : discover_bands_path],
    ["Merch", "Records, apparel and more", band && @products&.any? ? "#merch" : nil],
    ["Exclusive Content", "Behind the scenes, interviews, and more", nil],
    ["Subscriptions", "Support the band and get special perks",
     band ? public_band_subscriptions_path(band.slug) : (user_signed_in? ? subscriptions_path : discover_bands_path)],
    ["Posts", "News, updates and behind the scenes", band ? "#posts" : discover_bands_path],
    ["Tickets", "Live shows and tour dates", nil]
  ]
%>
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
  <% cards.each do |title, description, href| %>
    <% if href %>
      <%= link_to href, class: "rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 flex flex-col gap-3 hover:border-neutral-600 transition" do %>
        <div class="flex items-center justify-between">
          <span class="font-semibold text-white"><%= title %></span>
        </div>
        <p class="text-sm text-neutral-500"><%= description %></p>
      <% end %>
    <% else %>
      <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 flex flex-col gap-3 opacity-60 cursor-not-allowed">
        <div class="flex items-center justify-between">
          <span class="font-semibold text-white"><%= title %></span>
          <span class="text-[10px] uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-2 py-0.5">Soon</span>
        </div>
        <p class="text-sm text-neutral-500"><%= description %></p>
      </div>
    <% end %>
  <% end %>
</div>

<% if band && @products&.any? %>
  <%= render "public_bands/products", products: @products %>
<% end %>
