<% if user_signed_in? %>
  <details class="mt-3">
    <summary class="text-xs text-neutral-500 hover:text-neutral-300 transition cursor-pointer inline-block">Report</summary>
    <%= form_with url: url, scope: :report, method: :post, class: "mt-2 flex gap-2" do |form| %>
      <%= form.text_field :reason, placeholder: "Why are you reporting this?", class: "flex-1 rounded-full bg-black/40 border border-neutral-700 text-white text-xs px-3 py-1.5 focus:outline-none focus:border-neutral-500" %>
      <%= form.submit "Send", class: "rounded-full border border-neutral-700 text-white text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
    <% end %>
  </details>
<% end %>
