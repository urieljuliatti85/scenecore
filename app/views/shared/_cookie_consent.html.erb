<div
  data-controller="cookie-consent"
  class="hidden fixed inset-x-0 bottom-0 z-50 border-t border-neutral-800 bg-black/95 backdrop-blur px-4 py-4 sm:px-6"
>
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6">
    <p class="text-sm text-neutral-300 flex-1">
      We use cookies to understand how people use SceneCore. You can accept or decline analytics cookies —
      SceneCore works the same either way.
    </p>
    <div class="flex items-center gap-3 shrink-0">
      <button type="button" data-action="cookie-consent#decline" class="rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition cursor-pointer">Decline</button>
      <button type="button" data-action="cookie-consent#accept" class="rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer">Accept</button>
    </div>
  </div>
</div>
