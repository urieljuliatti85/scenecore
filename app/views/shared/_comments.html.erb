<div class="mt-4 pt-4 border-t border-neutral-800">
  <% if post.comments.any? %>
    <ul class="flex flex-col gap-3">
      <% post.comments.order(created_at: :asc).each do |comment| %>
        <li class="flex items-start justify-between gap-3">
          <p class="text-sm text-neutral-300">
            <span class="font-semibold text-white"><%= comment.user.name %></span>
            <span class="block text-neutral-400"><%= comment.body %></span>
          </p>
          <% if policy(comment).destroy? %>
            <%= button_to "Delete", post_comment_path(band.slug, post, comment), method: :delete, class: "text-xs text-red-500 hover:text-red-400 transition cursor-pointer shrink-0", form: { data: { turbo_confirm: "Delete this comment?" } } %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if user_signed_in? && policy(Comment.new(post: post)).create? %>
    <%= form_with model: Comment.new, url: post_comments_path(band.slug, post), method: :post, class: "mt-3 flex gap-2" do |form| %>
      <%= form.text_field :body, placeholder: "Write a comment...", class: "flex-1 rounded-full bg-black/40 border border-neutral-700 text-white text-sm px-4 py-2 focus:outline-none focus:border-neutral-500" %>
      <%= form.submit "Post", class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 hover:bg-yellow-300 transition cursor-pointer" %>
    <% end %>
  <% end %>
</div>
