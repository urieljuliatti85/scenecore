<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-5xl mx-auto">
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">Search</h1>

  <%# The header no longer carries a search field, so the form lives here —
      otherwise reaching this page would leave nowhere to type. %>
  <%= form_with url: search_path, method: :get, class: "flex flex-col sm:flex-row items-stretch sm:items-center gap-2 mb-6" do |form| %>
    <%= form.select :type, [ [ "Band", "band" ], [ "Album", "album" ] ], { selected: @type }, class: "rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    <%= form.text_field :q, value: @query, placeholder: "Search for a band or an album...", autofocus: @query.blank?, class: "flex-1 rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    <%= form.submit "Search", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-6 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
  <% end %>

  <% if @query.present? %>
    <p class="text-neutral-500 mb-8">
      <%= @results.size %> <%= @type %> result<%= "s" unless @results.size == 1 %> for "<%= @query %>"
    </p>
  <% else %>
    <p class="text-neutral-500 mb-8">Search for a band or an album.</p>
  <% end %>

  <% if @query.present? && @results.empty? %>
    <p class="text-neutral-500">No results found.</p>
  <% elsif @type == "band" %>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
      <% @results.each do |band| %>
        <%= link_to public_band_path(band.slug), class: "group rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden hover:border-neutral-600 transition" do %>
          <div class="aspect-square bg-neutral-800 flex items-center justify-center">
            <% if band.photo.attached? %>
              <%= image_tag band.photo, class: "w-full h-full object-cover" %>
            <% else %>
              <span class="text-neutral-600 text-sm">No photo</span>
            <% end %>
          </div>
          <div class="p-4">
            <p class="font-semibold text-white group-hover:text-yellow-400 transition flex items-center gap-1.5">
              <%= band.name %>
              <%= render "shared/verified_badge", band: band %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <ul class="flex flex-col gap-3">
      <% @results.each do |album| %>
        <li>
          <%= link_to public_band_path(album.band.slug), class: "group flex items-center justify-between gap-3 rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 hover:border-neutral-600 transition" do %>
            <div>
              <p class="font-semibold text-white group-hover:text-yellow-400 transition"><%= album.title %></p>
              <p class="text-sm text-neutral-500"><%= album.band.name %></p>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
