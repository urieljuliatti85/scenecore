<%# A stat becomes a jump link only when its section is actually on the page.
    The sections render conditionally, so linking unconditionally would leave
    a card pointing at an anchor that does not exist. %>
<% classes = "rounded-2xl border border-neutral-800 bg-black/30 px-5 py-4 flex flex-col gap-1" %>

<% if local_assigns[:anchor].present? %>
  <%= link_to anchor, class: "#{classes} hover:border-neutral-600 transition" do %>
    <span class="text-xs uppercase tracking-wide text-neutral-500"><%= label %></span>
    <span class="text-xl font-bold text-white"><%= count %></span>
  <% end %>
<% else %>
  <div class="<%= classes %>">
    <span class="text-xs uppercase tracking-wide text-neutral-500"><%= label %></span>
    <span class="text-xl font-bold text-white"><%= count %></span>
  </div>
<% end %>
