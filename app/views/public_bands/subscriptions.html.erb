<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-5xl mx-auto">
  <%= link_to public_band_path(@band.slug), class: "text-sm text-neutral-400 hover:text-white transition" do %>
    &larr; <%= @band.name %>
  <% end %>

  <h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight">Become a member</h1>
  <p class="mt-2 text-neutral-400">Support <%= @band.name %> and get closer to the music.</p>

  <% if user_signed_in? %>
    <% if @membership %>
      <p class="text-sm text-neutral-500 mt-6">
        You're currently a <span class="text-white font-semibold"><%= @membership.level.humanize %></span> member of <%= @band.name %>.
      </p>
    <% end %>
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <% [
        [ "fan", "Fan", "$3/mo", "Get closer to the band.",
          [ "Exclusive band feed", "News before the general public", "Behind-the-scenes photos", "Behind-the-scenes short videos — In development", "Selected demos & alternative versions", "Poll participation", "Fan badge & subscriber community" ] ],
        [ "supporter", "Supporter", "$5/mo", "Support the music and follow its creation.",
          [ "Everything in Fan", "Early access to releases", "Complete demos & rehearsal recordings", "Composition & production journals", "Exclusive videos & streams", "Digital supporter credits", "Merchandise discounts" ] ],
        [ "core_member", "Core Member", "$8/mo", "Become part of the band's core group.",
          [ "Everything in Supporter", "Private livestreams & Q&A", "Rare archives & unreleased versions", "Priority limited products", "Higher discounts & permanent supporter page", "Direct messages to the band", "A say in selected decisions" ] ]
      ].each do |level, label, price, promise, benefits| %>
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 flex flex-col gap-3">
          <div class="flex items-center justify-between">
            <span class="font-semibold text-white"><%= label %></span>
            <span class="text-sm text-neutral-400"><%= price %></span>
          </div>
          <p class="text-sm text-neutral-500"><%= promise %></p>
          <ul class="flex-1 flex flex-col gap-1.5 text-sm text-neutral-400">
            <% benefits.each do |benefit| %>
              <li class="flex items-start gap-2">
                <span class="text-yellow-400 mt-0.5">✓</span>
                <span><%= benefit %></span>
              </li>
            <% end %>
          </ul>
          <% if @membership&.active? && @membership.level == level %>
            <span class="text-center rounded-full border border-neutral-700 text-neutral-400 text-sm font-semibold px-4 py-2">Current plan</span>
            <%= button_to "Cancel plan", band_subscription_path(@band), method: :delete, class: "text-sm font-medium text-red-500 hover:text-red-400 transition cursor-pointer text-center", form: { data: { turbo_confirm: "Cancel your #{label} membership with #{@band.name}? This stops future billing." } } %>
          <% else %>
            <%= button_to "Join as #{label}", band_subscription_path(@band), method: :post, params: { subscription: { level: level } }, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer w-full", form: { data: { turbo: false } } %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-6 text-neutral-400">
      <%= link_to "Sign in", new_user_session_path, class: "text-yellow-400 hover:text-yellow-300 transition" %> to become a member of <%= @band.name %>.
    </p>
  <% end %>
</section>
