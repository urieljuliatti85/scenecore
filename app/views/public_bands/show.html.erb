<section class="px-4 sm:px-6 py-10 sm:py-16 max-w-5xl mx-auto">
  <div class="relative rounded-[2rem] sm:rounded-[2.5rem] overflow-hidden p-6 sm:p-10 shadow-2xl shadow-black/40">
    <% if @band.photo.attached? %>
      <%= image_tag @band.photo, class: "absolute inset-0 w-full h-full object-cover" %>
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/70 to-black/40"></div>
    <% else %>
      <div class="absolute inset-0 bg-gradient-to-br from-neutral-800 via-neutral-900 to-black"></div>
    <% end %>

    <div class="relative">
      <p class="text-xs sm:text-sm tracking-[0.2em] text-neutral-500 uppercase mb-4">
        Band<% if @band.category %> · <%= @band.category.name %><% end %>
      </p>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6">
        <%= @band.name %>
      </h1>

      <% if @band.description.present? %>
        <p class="text-neutral-300 text-base sm:text-lg max-w-2xl mb-8">
          <%= @band.description %>
        </p>
      <% end %>

      <div class="flex flex-wrap items-center gap-4 mb-6">
        <% if user_signed_in? %>
          <% if @following %>
            <%= button_to "Following", band_follow_path(@band), method: :delete, class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition cursor-pointer" %>
          <% else %>
            <%= button_to "Follow", band_follow_path(@band), method: :post, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
          <% end %>
        <% end %>

        <span class="text-neutral-400 text-sm">
          <%= pluralize(@band.followers_count, "follower") %>
        </span>

        <%# A band member arriving at their own public page has no way back
            into the panel except the header's "Your bands". This is the
            same check the panel itself makes, so the link is never shown
            to someone it would 404 for. %>
        <% if policy(@band).show? %>
          <%= link_to band_path(@band), class: "flex items-center gap-2 rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition" do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0" aria-hidden="true">
              <path d="M4 19V10" /><path d="M10 19V5" /><path d="M16 19v-6" /><path d="M22 19H3" />
            </svg>
            Painel da Banda
          <% end %>
        <% end %>

        <% if @membership&.can_access?(:core_member) %>
          <%= link_to "Message the band", my_band_direct_messages_path(@band.slug), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
        <% end %>

        <% if @core_members_count.positive? %>
          <%= link_to "Core Members", public_band_credits_path(@band.slug), class: "rounded-full border border-neutral-700 text-white font-semibold px-5 py-2.5 hover:border-neutral-500 transition" %>
        <% end %>

        <%= render "shared/social_links", band: @band %>
      </div>

      <%# For someone with no BandMembership here yet — e.g. an actual
          member of the band who has never signed up on SceneCore. This is
          a message to the platform, not a grant: a Platform Administrator
          reviews it before anything changes (docs/proposals/band-admin-promotion-request.md). %>
      <% if user_signed_in? && @own_band_membership.nil? %>
        <div class="mt-4">
          <% if @own_pending_band_admin_request %>
            <p class="text-sm text-neutral-400 mb-2">Your request to administer this band is awaiting review by SceneCore.</p>
            <%= button_to "Withdraw request", band_admin_request_path(@band.slug), method: :delete, class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition cursor-pointer" %>
          <% else %>
            <%= button_to "Is this your band? Request administrator access", band_admin_request_path(@band.slug), method: :post, class: "rounded-full border border-neutral-700 text-neutral-300 text-sm font-semibold px-4 py-2 hover:border-neutral-500 hover:text-white transition cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <%# Merch only earns a card when the band has something published to sell,
          so the grid tracks the card count instead of assuming three. %>
      <div class="grid <%= @products.any? ? "grid-cols-2 sm:grid-cols-4" : "grid-cols-3" %> gap-3 sm:gap-4">
        <%= render "hero_stat", label: "Albums", count: @albums.size, anchor: ("#albums" if @albums.any?) %>
        <% if @products.any? %>
          <%= render "hero_stat", label: "Merch", count: @products.size, anchor: "#merch" %>
        <% end %>
        <%= render "hero_stat", label: "Posts", count: @posts.size, anchor: ("#posts" if @posts.any?) %>
        <%= render "hero_stat", label: "Followers", count: @band.followers_count %>
      </div>

      <div class="mt-6">
        <%= render "shared/coming_soon_cards", band: @band %>
      </div>
    </div>
  </div>

  <% if @events.any? %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-neutral-300 mb-4">Shows</h2>
      <div class="flex flex-col gap-4">
        <% @events.each do |event| %>
          <article class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <p class="font-semibold text-white"><%= event.title %></p>
              <p class="text-sm text-neutral-400 mt-1">
                <%= time_tag event.starts_at, event.starts_at.strftime("%d %b %Y · %H:%M") %>
                · <%= event.location %>
              </p>
              <% if event.description.present? %>
                <p class="text-sm text-neutral-500 mt-2 whitespace-pre-line"><%= event.description %></p>
              <% end %>
            </div>
            <% if event.internal_tickets? %>
              <%= link_to "Get tickets", public_event_path(@band.slug, event), class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition self-start shrink-0" %>
            <% elsif event.ticket_link %>
              <%= link_to "Get tickets", event.ticket_link, target: "_blank", rel: "noopener noreferrer", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition self-start shrink-0" %>
            <% else %>
              <%= link_to "Event details", public_event_path(@band.slug, event), class: "rounded-full border border-neutral-700 text-neutral-300 text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition self-start shrink-0" %>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "products", products: @products %>

  <% if @albums.any? %>
    <div id="albums" class="mt-10 scroll-mt-24">
      <h2 class="text-lg font-semibold text-neutral-300 mb-4">Albums</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        <% @albums.each do |album| %>
          <% if album.visible_to?(current_user) %>
            <%= link_to public_album_path(@band.slug, album), class: "group rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden transition hover:border-neutral-600" do %>
              <div class="aspect-square bg-neutral-800 flex items-center justify-center">
                <% if album.cover_url.present? %>
                  <%= image_tag album.cover_url, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
                <% else %>
                  <span class="text-neutral-600 text-sm">No cover</span>
                <% end %>
              </div>
              <div class="p-4">
                <p class="font-semibold text-white group-hover:text-yellow-400 transition"><%= album.title %></p>
                <% if album.ratings_count.positive? %>
                  <p class="text-sm text-neutral-500 group-hover:text-neutral-300 transition">
                    <span class="text-yellow-400">★</span> <%= album.average_rating %> (<%= album.ratings_count %>)
                  </p>
                <% elsif album.spotify_link_id %>
                  <p class="text-sm text-neutral-500 group-hover:text-neutral-300 transition flex items-center gap-1.5">
                    <%= render "shared/spotify_icon", classes: "h-4 w-4 shrink-0" %>
                    Listen on Spotify
                  </p>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden opacity-75">
              <div class="aspect-square bg-neutral-800 flex items-center justify-center">
                <span class="text-neutral-600 text-3xl" aria-hidden="true">🔒</span>
              </div>
              <div class="p-4">
                <p class="font-semibold text-white"><%= album.title %></p>
                <p class="text-xs text-neutral-500 mt-1">
                  <%= album.required_level&.humanize %> early access
                </p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @core_sessions.any? %>
    <div class="mt-10">
      <h2 class="text-lg font-semibold text-neutral-300 mb-4">Member Sessions</h2>
      <div class="flex flex-col gap-4">
        <% @core_sessions.each do |core_session| %>
          <article class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-5">
            <% if core_session.visible_to?(current_user) %>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <div>
                  <p class="font-semibold text-white"><%= core_session.title %></p>
                  <p class="text-sm text-neutral-400 mt-1">
                    <%= core_session.session_type.humanize %> · <%= core_session.audience_level.humanize %> and above · <%= time_tag core_session.starts_at, core_session.starts_at.strftime("%d %b %Y · %H:%M") %>
                  </p>
                  <% if core_session.description.present? %>
                    <p class="text-sm text-neutral-500 mt-2 whitespace-pre-line"><%= core_session.description %></p>
                  <% end %>
                  <p class="text-xs text-neutral-500 mt-2">
                    <% if core_session.capacity.present? %>
                      <%= core_session.spots_remaining %> of <%= core_session.capacity %> spots left
                    <% else %>
                      <%= pluralize(core_session.rsvps.count, "person") %> confirmed
                    <% end %>
                  </p>
                  <% if core_session.access_link %>
                    <%= link_to "Open private session", core_session.access_link, target: "_blank", rel: "noopener noreferrer", class: "inline-block mt-3 text-sm text-yellow-400 hover:text-yellow-300 transition" %>
                  <% end %>
                </div>

                <% if core_session.rsvped_by?(current_user) %>
                  <span class="rounded-full border border-neutral-700 text-neutral-400 text-sm font-semibold px-4 py-2 self-start shrink-0">You're on the list</span>
                  <%= button_to "Cancel RSVP", cancel_core_session_rsvp_path(@band.slug, core_session), method: :delete, class: "text-sm text-red-400 hover:text-red-300 transition cursor-pointer self-start shrink-0" %>
                <% elsif core_session.rsvpable_by?(current_user) %>
                  <%= button_to "RSVP", core_session_rsvp_path(@band.slug, core_session), method: :post, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start shrink-0" %>
                <% else %>
                  <span class="rounded-full border border-neutral-700 text-neutral-500 text-sm font-semibold px-4 py-2 self-start shrink-0">Fully booked</span>
                <% end %>
              </div>
            <% else %>
              <p class="font-semibold text-white"><%= core_session.title %></p>
              <%= render "shared/locked_content_notice", required_level: core_session.audience_level %>
            <% end %>
          </article>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @posts.any? %>
    <div id="posts" class="mt-10 flex flex-col gap-6 scroll-mt-24">
      <h2 class="text-lg font-semibold text-neutral-300">Posts</h2>
      <% @posts.each do |post| %>
        <article id="post-<%= post.id %>" class="rounded-3xl bg-gradient-to-br from-neutral-900 to-black border border-neutral-800 px-5 py-5 scroll-mt-24">
          <% if post.visible_to?(current_user, following: @following) %>
            <% if post.image.attached? %>
              <%= image_tag post.image, class: "w-full max-h-96 object-cover rounded-2xl mb-4" %>
            <% end %>
            <% unless post.announcement? %>
              <span class="inline-block text-[10px] uppercase tracking-wide text-yellow-400 border border-yellow-400/40 rounded-full px-2 py-0.5 mb-2"><%= post.post_type.titleize %></span>
            <% end %>
            <h3 class="text-white font-semibold mb-2"><%= post.title %></h3>
            <%# No text-sm here: .trix-content sets its own base size, and
                overriding it shrank every heading the band wrote (h1 is
                em-relative) into the body text. %>
            <%= post.body %>
            <% if post.attachments.attached? %>
              <div class="mt-4">
                <%= render "posts/attachments", attachments: post.attachments %>
              </div>
            <% end %>

            <%= render "shared/report_button", url: report_post_path(@band.slug, post) %>

            <%= render "shared/comments", band: @band, post: post %>
          <% else %>
            <h3 class="text-white font-semibold"><%= post.title %></h3>
            <%= render "shared/locked_content_notice", required_level: post.required_level %>
          <% end %>
        </article>
      <% end %>
    </div>
  <% end %>

  <% if @polls.any? %>
    <div class="mt-10 flex flex-col gap-6">
      <h2 class="text-lg font-semibold text-neutral-300">Polls</h2>
      <% @polls.each do |poll| %>
        <%= render "poll", band: @band, poll: poll %>
      <% end %>
    </div>
  <% end %>

  <% if @albums.none? && @posts.none? && @events.none? && @polls.none? && @products.none? %>
    <div class="mt-10 rounded-3xl border border-dashed border-neutral-800 px-5 py-10 text-center">
      <p class="text-neutral-400">No music, merch, posts or shows published yet. Check back soon.</p>
    </div>
  <% end %>
</section>
