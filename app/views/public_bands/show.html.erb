<section class="px-4 sm:px-6 py-16 sm:py-24 max-w-5xl mx-auto">
  <p class="text-xs sm:text-sm tracking-[0.2em] text-neutral-500 uppercase mb-4">Band</p>

  <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-6">
    <%= @band.name %>
  </h1>

  <% if @band.description.present? %>
    <p class="text-neutral-300 text-base sm:text-lg max-w-2xl mb-8">
      <%= @band.description %>
    </p>
  <% end %>

  <%= render "shared/social_links", band: @band %>

  <% if @albums.any? %>
    <div class="mt-10 flex flex-col gap-8">
      <% @albums.each do |album| %>
        <div>
          <h2 class="text-lg font-semibold text-neutral-300 mb-3"><%= album.title %></h2>
          <ul class="flex flex-col gap-2">
            <% album.tracks.published.order(:track_number).each do |track| %>
              <li class="flex flex-col gap-3 rounded-lg border border-neutral-800 px-4 py-3">
                <div class="flex items-center gap-3">
                  <span class="text-neutral-500 text-sm"><%= track.track_number %></span>
                  <span class="text-white"><%= track.title %></span>
                </div>

                <% if track.spotify_embed_url.present? %>
                  <iframe src="<%= track.spotify_embed_url %>" width="100%" height="152" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" title="Spotify player for <%= track.title %>"></iframe>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="px-4 sm:px-6 pb-20 sm:pb-28 max-w-5xl mx-auto">
  <%= render "shared/coming_soon_cards" %>
</section>
