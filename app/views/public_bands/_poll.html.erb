<% poll_visible = poll.visible_to?(current_user, following: @following) %>
<article id="poll-<%= poll.id %>" class="rounded-3xl bg-gradient-to-br from-neutral-900 to-black border border-neutral-800 px-5 py-5 scroll-mt-24">
  <h3 class="text-white font-semibold <%= "mb-4" if poll_visible %>"><%= poll.question %></h3>

  <% if poll_visible %>
    <% voted = poll.voted_by?(current_user) %>
    <% show_form = poll.open? && poll.voteable_by?(current_user) && (!voted || poll.allow_vote_change?) %>
    <% selected_option_ids = current_user ? poll.poll_options.joins(:poll_votes).where(poll_votes: { user: current_user }).ids : [] %>

    <% if show_form %>
      <%= form_with url: poll_vote_path(band.slug, poll), method: :put, class: "flex flex-col gap-2" do |form| %>
        <% poll.poll_options.each do |option| %>
          <label class="flex items-center gap-2 text-sm text-neutral-300 cursor-pointer">
            <% if poll.allow_multiple_choices? %>
              <%= check_box_tag "poll_vote[option_ids][]", option.id, selected_option_ids.include?(option.id), id: "poll_option_#{option.id}" %>
            <% else %>
              <%= radio_button_tag "poll_vote[option_ids][]", option.id, selected_option_ids.include?(option.id), id: "poll_option_#{option.id}" %>
            <% end %>
            <%= option.label %>
          </label>
        <% end %>
        <%= form.submit voted ? "Update vote" : "Vote", class: "mt-2 rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-1.5 hover:bg-yellow-300 transition cursor-pointer self-start" %>
      <% end %>
    <% else %>
      <% total_votes = poll.poll_options.sum(&:votes_count) %>
      <div class="space-y-2">
        <% poll.poll_options.each do |option| %>
          <% percentage = total_votes.positive? ? (option.votes_count.to_f / total_votes * 100).round : 0 %>
          <div>
            <div class="flex items-center justify-between text-sm text-neutral-300">
              <span><%= option.label %></span>
              <span class="text-neutral-500"><%= percentage %>%</span>
            </div>
            <div class="mt-1 h-1.5 rounded-full bg-neutral-800 overflow-hidden">
              <div class="h-full bg-yellow-400" style="width: <%= percentage %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
      <% if !poll.open? %>
        <p class="mt-3 text-xs text-neutral-500">This poll is closed.</p>
      <% elsif voted %>
        <p class="mt-3 text-xs text-neutral-500">You already voted.</p>
      <% elsif !user_signed_in? %>
        <p class="mt-3 text-xs text-neutral-500"><%= link_to "Sign in", new_user_session_path, class: "text-yellow-400 hover:text-yellow-300 transition" %> to vote.</p>
      <% end %>
    <% end %>
  <% else %>
    <%= render "shared/locked_content_notice", required_level: poll.required_level %>
  <% end %>
</article>
