<% if products.any? %>
  <div id="merch" class="mt-10 scroll-mt-24">
    <div class="flex items-end justify-between gap-4 mb-4">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-neutral-500 mb-1">Support the band</p>
        <h2 class="text-lg font-semibold text-neutral-300">Merch</h2>
      </div>
      <span class="text-xs text-neutral-600"><%= pluralize(products.size, "product") %></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% products.each do |product| %>
        <% product_visible = product.available_to?(current_user) %>
        <% variants = product.variants.to_a %>
        <% available_variants = variants.reject(&:sold_out?) %>
        <% lowest_price = variants.map(&:price_cents).min %>
        <% highest_price = variants.map(&:price_cents).max %>
        <% discount_percentage = MerchDiscount.percentage_for(@membership) %>

        <article class="rounded-2xl border border-neutral-800 bg-neutral-900/60 overflow-hidden flex flex-col">
          <% unless product_visible %>
            <div class="aspect-square bg-neutral-800 flex items-center justify-center">
              <span class="text-neutral-600 text-3xl" aria-hidden="true">🔒</span>
            </div>
            <div class="p-5 flex flex-col gap-3 flex-1">
              <h3 class="font-semibold text-white"><%= product.name %></h3>
              <p class="text-sm text-neutral-400">Available first to <%= product.required_level.humanize %>.</p>
              <%= render "shared/locked_content_notice", required_level: product.required_level %>
            </div>
          <% else %>
          <% if product.image.attached? %>
            <%= image_tag product.image, alt: product.name, class: "w-full aspect-square object-cover" %>
          <% end %>

          <div class="p-5 flex flex-col gap-4 flex-1">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h3 class="font-semibold text-white"><%= product.name %></h3>
              <% if product.discogs? && product.artist_name.present? %>
                <p class="text-xs text-neutral-500 mt-1"><%= product.artist_name %></p>
              <% end %>
            </div>

            <% if available_variants.any? %>
              <span class="shrink-0 text-[10px] uppercase tracking-wide text-emerald-400 border border-emerald-900 rounded-full px-2 py-1">In stock</span>
            <% else %>
              <span class="shrink-0 text-[10px] uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-2 py-1">Sold out</span>
            <% end %>
          </div>

          <% if product.description.present? %>
            <p class="text-sm text-neutral-400 line-clamp-3"><%= product.description %></p>
          <% end %>

          <% if product.discogs? %>
            <div class="flex flex-wrap gap-2 text-xs text-neutral-500">
              <% [product.release_format, product.release_year, product.label_name].compact_blank.each do |detail| %>
                <span class="rounded-full border border-neutral-800 px-2.5 py-1"><%= detail %></span>
              <% end %>
            </div>
          <% end %>

          <% if variants.any? %>
            <div class="flex flex-wrap gap-2">
              <% variants.each do |variant| %>
                <span class="rounded-full border border-neutral-800 px-2.5 py-1 text-xs <%= variant.sold_out? ? 'text-neutral-600 line-through' : 'text-neutral-400' %>">
                  <%= variant.name %>
                </span>
              <% end %>
            </div>
          <% end %>

          <div class="mt-auto flex items-end justify-between gap-3 pt-2 border-t border-neutral-800">
            <div>
              <p class="text-xs uppercase tracking-wide text-neutral-600">Price</p>
              <p class="text-lg font-bold text-white">
                <% if lowest_price.present? %>
                  <% discounted_lowest_price = (lowest_price * (100 - discount_percentage) / 100.0).round %>
                  <% if lowest_price == highest_price %>
                    <% if discount_percentage.positive? %><span class="text-sm font-normal text-neutral-500 line-through"><%= number_to_currency(lowest_price / 100.0) %></span> <% end %><%= number_to_currency(discounted_lowest_price / 100.0) %>
                  <% else %>
                    From <%= number_to_currency(discounted_lowest_price / 100.0) %>
                  <% end %>
                <% else %>
                  —
                <% end %>
              </p>
              <% if discount_percentage.positive? %>
                <p class="text-xs text-emerald-400 mt-1"><%= discount_percentage %>% member discount applied</p>
              <% end %>
            </div>

            <% if product.discogs? %>
              <%= link_to "Release details", product.discogs_url, target: "_blank", rel: "noopener noreferrer", class: "text-xs text-neutral-500 underline hover:text-neutral-300 transition" %>
            <% end %>
          </div>

          <%# Buying needs an account, since the cart belongs to a user. A
              signed-out visitor is sent to sign in rather than shown a
              button that cannot work. %>
          <% if available_variants.any? %>
            <% if user_signed_in? %>
              <%= form_with url: add_cart_path, class: "flex items-center gap-2" do |form| %>
                <% if variants.size > 1 %>
                  <%= form.select :product_variant_id,
                        available_variants.map { |v| [ "#{v.name} — #{number_to_currency((v.price_cents * (100 - discount_percentage) / 100.0).round / 100.0)}", v.id ] },
                        {},
                        class: "flex-1 min-w-0 rounded-lg bg-neutral-950 border border-neutral-800 text-white text-sm px-3 py-2" %>
                <% else %>
                  <%= form.hidden_field :product_variant_id, value: available_variants.first.id %>
                <% end %>
                <%= form.submit "Add to cart", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-4 py-2 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer shrink-0" %>
              <% end %>
            <% else %>
              <%= link_to "Sign in to buy", new_user_session_path, class: "block text-center rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition" %>
            <% end %>
          <% end %>
          </div>
          <% end %>
        </article>
      <% end %>
    </div>
  </div>
<% end %>
