<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-md mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-8">Log in</h1>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "flex flex-col gap-5" }) do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-neutral-700 bg-neutral-900 text-yellow-400 focus:ring-yellow-400" %>
        <%= f.label :remember_me, class: "text-sm text-neutral-300" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start" %>
  <% end %>

  <%= render "devise/shared/links" %>
</section>
