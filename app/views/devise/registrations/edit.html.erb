<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-md mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-8">Edit <%= resource_name.to_s.humanize %></h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "flex flex-col gap-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.text_field :name, autofocus: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="text-sm text-neutral-400">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
    <% end %>

    <div>
      <%= f.label :password, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <p class="text-xs text-neutral-500 mb-1">leave blank if you don't want to change it<% if @minimum_password_length %> (<%= @minimum_password_length %> characters minimum)<% end %></p>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= f.label :current_password, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <p class="text-xs text-neutral-500 mb-1">we need your current password to confirm your changes</p>
      <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <%= f.submit "Update", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start" %>
  <% end %>

  <div class="mt-10 pt-6 border-t border-neutral-800">
    <h2 class="text-sm font-semibold text-neutral-300 mb-2">Cancel my account</h2>
    <p class="text-sm text-neutral-500 mb-3">Unhappy? You can cancel your account at any time.</p>
    <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete, class: "rounded-full border border-red-900 text-red-400 text-sm font-semibold px-5 py-2.5 hover:border-red-700 transition cursor-pointer" %>
  </div>
</section>
