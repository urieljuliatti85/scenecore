<%# Compact outline icons keep the administration navigation scannable without
    adding an icon dependency. The section name controls only presentation;
    authorization and destinations remain owned by the existing routes. %>
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="h-3.5 w-3.5 shrink-0 transition <%= current ? "text-yellow-400" : "text-neutral-600 group-hover:text-yellow-300" %>"
  aria-hidden="true"
>
  <% case section.to_sym %>
  <% when :dashboard %>
    <rect x="3" y="3" width="7" height="7" rx="1" />
    <rect x="14" y="3" width="7" height="7" rx="1" />
    <rect x="3" y="14" width="7" height="7" rx="1" />
    <rect x="14" y="14" width="7" height="7" rx="1" />
  <% when :bands %>
    <path d="M9 18V5l11-2v13" />
    <circle cx="6" cy="18" r="3" />
    <circle cx="17" cy="16" r="3" />
  <% when :users %>
    <circle cx="9" cy="8" r="3" />
    <path d="M3 20c0-4 2.5-6 6-6s6 2 6 6" />
    <path d="M16 5.5a3 3 0 0 1 0 5.5M17 14c2.7.5 4 2.3 4 5" />
  <% when :memberships %>
    <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z" />
  <% when :subscriptions %>
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3 10h18M7 15h3" />
  <% when :moderation %>
    <path d="M12 3 4.5 6v5.5c0 4.5 3 7.5 7.5 9.5 4.5-2 7.5-5 7.5-9.5V6L12 3Z" />
    <path d="m9 12 2 2 4-4" />
  <% when :categories %>
    <path d="m12 2 9 5-9 5-9-5 9-5Z" />
    <path d="m3 12 9 5 9-5M3 17l9 5 9-5" />
  <% when :analytics %>
    <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
  <% when :financial_status %>
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="M3 10h18M16 15h2" />
  <% when :reports %>
    <path d="M5 21V4M5 5h11l-1.5 4L18 13H5" />
  <% when :band_admin_requests %>
    <circle cx="9" cy="8" r="3" />
    <path d="M3 20c0-4 2.5-6 6-6 1.4 0 2.6.3 3.5.9" />
    <path d="M17 11v6M14 14h6" />
  <% when :audit_logs %>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3 2" />
  <% when :platform_settings %>
    <circle cx="12" cy="12" r="3" />
    <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z" />
  <% else %>
    <circle cx="12" cy="12" r="9" />
  <% end %>
</svg>
