<% content_for :title, "Platform Settings — Admin — SceneCore" %>

<div class="max-w-xl">
  <h1 class="text-3xl font-extrabold tracking-tight mb-2">Platform Settings</h1>
  <p class="text-neutral-500 mb-8">Global configuration for the SceneCore platform.</p>

  <%= form_with model: @platform_setting, url: admin_platform_settings_path, method: :patch, class: "flex flex-col gap-5" do |form| %>
    <% if @platform_setting.errors.any? %>
      <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
        <% @platform_setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div class="pt-4 border-t border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-300 mb-3">Fees</h2>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <%= form.label :membership_fee_percentage, "Membership fee (%)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
          <%= form.number_field :membership_fee_percentage, min: 0, max: 100, class: "w-32 rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
          <p class="text-xs text-neutral-600 mt-1">ADR-008. Charged on each monthly subscription charge.</p>
        </div>
        <div>
          <%= form.label :store_fee_percentage, "Store fee (%)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
          <%= form.number_field :store_fee_percentage, min: 0, max: 100, class: "w-32 rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
          <p class="text-xs text-neutral-600 mt-1">ADR-007. Charged on the subtotal of each order.</p>
        </div>
      </div>
    </div>

    <div class="pt-4 border-t border-neutral-800 flex flex-col gap-4">
      <h2 class="text-sm font-semibold text-neutral-300">Legal & contact</h2>

      <div>
        <%= form.label :terms_of_service_url, "Terms of Service URL", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.url_field :terms_of_service_url, placeholder: "https://...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>

      <div>
        <%= form.label :privacy_policy_url, "Privacy Policy URL", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.url_field :privacy_policy_url, placeholder: "https://...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>

      <div>
        <%= form.label :support_email, "Support email", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.email_field :support_email, placeholder: "support@...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>
    </div>

    <div class="pt-4 border-t border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-300 mb-3">Notifications</h2>

      <%= form.label :notification_sender_email, "Sender email", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.email_field :notification_sender_email, placeholder: "noreply@...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div class="pt-4 border-t border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-300 mb-3">Access</h2>

      <label class="flex items-center gap-2 text-sm text-neutral-300">
        <%= form.check_box :band_signups_enabled, class: "rounded border-neutral-700 bg-neutral-900 text-yellow-400 focus:ring-yellow-400" %>
        Allow new bands to sign up
      </label>
      <p class="text-xs text-neutral-500 mt-1">When off, band registration is closed platform-wide.</p>
    </div>

    <%= form.submit "Save settings", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start" %>
  <% end %>
</div>
