<% state_classes = {
     ok: [ "border-emerald-500/30 bg-emerald-500/10 text-emerald-300", "bg-emerald-400" ],
     warning: [ "border-yellow-500/30 bg-yellow-500/10 text-yellow-300", "bg-yellow-400" ],
     error: [ "border-red-500/30 bg-red-500/10 text-red-300", "bg-red-400" ],
     unknown: [ "border-neutral-600 bg-neutral-700/30 text-neutral-400", "bg-neutral-500" ]
   }.fetch(state) %>

<div class="flex items-start justify-between gap-3 border-b border-[#383838] py-2 last:border-b-0">
  <div class="min-w-0">
    <p class="text-[0.68rem] font-medium text-neutral-300"><%= label %></p>
    <% if local_assigns[:detail].present? %>
      <p class="mt-0.5 break-words text-[0.6rem] text-neutral-600"><%= detail %></p>
    <% end %>
  </div>

  <span class="inline-flex shrink-0 items-center gap-1.5 rounded border px-2 py-1 text-[0.56rem] font-semibold uppercase tracking-wide <%= state_classes.first %>">
    <span class="h-1.5 w-1.5 rounded-full <%= state_classes.last %>" aria-hidden="true"></span>
    <%= value %>
  </span>
</div>
