<% content_for :title, "Dashboard — Admin — SceneCore" %>

<div>
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-7">
    <div>
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-fuchsia-300 mb-2">Platform overview</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">Dashboard</h1>
      <p class="text-slate-500 mt-2">The SceneCore platform at a glance.</p>
    </div>

    <% if @summary %>
      <div class="inline-flex self-start lg:self-auto items-center rounded-xl border border-[#1b2b55] bg-[#0a1230] p-1">
        <% GoogleAnalyticsClient::ALLOWED_DAY_RANGES.each do |range| %>
          <%= link_to "#{range} days", admin_root_path(days: range), class: "rounded-lg text-xs font-semibold px-3 py-2 transition #{@days == range ? "bg-fuchsia-500 text-white" : "text-slate-500 hover:text-white hover:bg-white/5"}" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div id="platform-counts" class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-9">
    <%= render "card",
          section: :bands,
          label: "Pending bands",
          count: @pending_bands_count,
          link_label: "Review queue",
          link_path: admin_bands_path(status: "pending") %>

    <%= render "card",
          section: :bands,
          label: "Total bands",
          count: @bands_count,
          link_label: "Manage bands",
          link_path: admin_bands_path %>

    <%= render "card",
          section: :users,
          label: "Total users",
          count: @users_count,
          link_label: "Manage users",
          link_path: admin_users_path %>
  </div>

  <section aria-labelledby="traffic-heading">
    <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
      <div>
        <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-cyan-300 mb-2">Audience</p>
        <h2 id="traffic-heading" class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">Traffic</h2>
        <p class="text-slate-500 text-sm mt-1">Across all bands, last <%= @days %> days, from Google Analytics.</p>
      </div>
      <%= link_to "Full analytics", admin_analytics_path, class: "inline-flex items-center gap-2 text-sm font-semibold text-cyan-300 hover:text-white transition" %>
    </div>

    <% if @analytics_error %>
      <p class="rounded-2xl border border-rose-500/30 bg-rose-500/10 text-rose-300 text-sm p-5"><%= @analytics_error %></p>
    <% elsif @summary.nil? %>
      <div class="rounded-2xl border border-[#1b2b55] bg-[#0a1230] p-6">
        <p class="text-slate-400 text-sm">
          Google Analytics isn't configured yet, so there is no traffic to show.
          <%= link_to "See what it needs", admin_analytics_path, class: "text-cyan-300 hover:text-white transition" %>.
        </p>
      </div>
    <% else %>
      <%= render "admin/analytics/metric_row", metrics: [
            [ "Unique Visitors", number_with_delimiter(@summary.active_users) ],
            [ "Sessions", number_with_delimiter(@summary.sessions) ],
            [ "Total Pageviews", number_with_delimiter(@summary.page_views) ],
            [ "Bounce Rate", analytics_percentage(@summary.bounce_rate) ],
            [ "Average Session", analytics_duration(@summary.session_duration) ]
          ] %>

      <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)] gap-5 mt-5">
        <div class="rounded-2xl border border-[#1b2b55] bg-[#0a1230] p-5 sm:p-6 min-w-0">
          <div class="flex items-start justify-between gap-4 mb-5">
            <div>
              <p class="text-sm font-semibold text-white">Audience trend</p>
              <p class="text-xs text-slate-500 mt-1">Daily active users across the selected period</p>
            </div>
            <span class="inline-flex items-center gap-2 rounded-full border border-fuchsia-500/30 bg-fuchsia-500/10 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-wide text-fuchsia-300">
              <span class="h-1.5 w-1.5 rounded-full bg-fuchsia-400" aria-hidden="true"></span>
              Live data
            </span>
          </div>

          <% if @summary.daily_series.any? %>
            <%= area_chart @summary.daily_series.to_h { |point| [ point.date.strftime("%d %b"), point.active_users ] },
                  height: "340px", colors: [ "#d946ef" ], legend: false, curve: false,
                  library: { interaction: { mode: "index" } } %>
          <% else %>
            <div class="h-[340px] flex items-center justify-center">
              <p class="text-slate-500 text-sm">No data for this period.</p>
            </div>
          <% end %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-1 gap-5">
          <%= render "admin/analytics/breakdown", title: "Sources", count_header: "Sessions",
                rows: @summary.channels, count_method: :sessions, accent: "bg-fuchsia-500/15", limit: 5 %>

          <%= render "admin/analytics/breakdown", title: "Top pages", count_header: "Pageviews",
                rows: @summary.top_pages, count_method: :views, label_method: :path,
                accent: "bg-cyan-500/15", limit: 5 %>
        </div>
      </div>
    <% end %>
  </section>
</div>
