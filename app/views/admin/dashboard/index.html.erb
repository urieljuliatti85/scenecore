<% content_for :title, "Dashboard — Admin — SceneCore" %>

<p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-2">Overview</p>
<h1 class="text-3xl font-extrabold tracking-tight mb-8">Dashboard</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
  <%= render "card",
        section: :bands,
        label: "Pending bands",
        count: @pending_bands_count,
        link_label: "View bands",
        link_path: admin_bands_path(status: "pending") %>

  <%= render "card",
        section: :bands,
        label: "Total bands",
        count: @bands_count,
        link_label: "View all",
        link_path: admin_bands_path %>

  <%= render "card",
        section: :users,
        label: "Total users",
        count: @users_count,
        link_label: "View users",
        link_path: admin_users_path %>
</div>
