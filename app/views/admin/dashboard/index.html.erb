<% content_for :title, "Dashboard — Admin — SceneCore" %>

<div class="min-h-[calc(100vh-4.5rem)] overflow-hidden rounded-lg border border-[#383838] bg-[#202020]">
  <header class="flex flex-col gap-3 border-b border-[#383838] px-3 py-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-sm bg-yellow-400" aria-hidden="true"></span>
        <h1 class="text-sm font-semibold text-neutral-100">Platform dashboard</h1>
      </div>
      <p class="mt-1 text-[0.65rem] text-neutral-600">The SceneCore platform at a glance.</p>
    </div>

    <% if @summary %>
      <div class="inline-flex self-start items-center rounded-md border border-[#444] bg-[#252525] p-0.5 sm:self-auto">
        <% GoogleAnalyticsClient::ALLOWED_DAY_RANGES.each do |range| %>
          <%= link_to "#{range} days", admin_root_path(days: range), class: "rounded px-2.5 py-1.5 text-[0.65rem] font-medium transition #{@days == range ? "bg-yellow-400 text-black" : "text-neutral-500 hover:bg-[#333] hover:text-neutral-100"}" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_18rem]">
    <section class="min-w-0 xl:border-r xl:border-[#383838]" aria-labelledby="traffic-heading">
      <div class="flex flex-wrap items-end justify-between gap-3 border-b border-[#383838] px-3 py-3">
        <div>
          <p class="text-[0.58rem] font-medium uppercase tracking-[0.14em] text-neutral-600">Audience</p>
          <h2 id="traffic-heading" class="mt-1 text-xs font-semibold text-neutral-200">Traffic overview</h2>
          <p class="mt-1 text-[0.65rem] text-neutral-600">Across all bands, last <%= @days %> days, from Google Analytics.</p>
        </div>
        <%= link_to "Open analytics", admin_analytics_path, class: "rounded-md bg-yellow-400 px-3 py-1.5 text-[0.65rem] font-semibold text-black hover:bg-yellow-300 transition" %>
      </div>

      <% if @analytics_error %>
        <div class="m-3 rounded-md border border-red-500/30 bg-red-500/10 p-4">
          <p class="text-xs text-red-300"><%= @analytics_error %></p>
        </div>
      <% elsif @summary.nil? %>
        <div class="m-3 rounded-md border border-[#444] bg-[#252525] p-4">
          <p class="text-xs text-neutral-500">
            Google Analytics isn't configured yet, so there is no traffic to show.
            <%= link_to "See what it needs", admin_analytics_path, class: "font-medium text-yellow-400 hover:text-yellow-200 transition" %>.
          </p>
        </div>
      <% else %>
        <%= render "admin/analytics/metric_row", metrics: [
              [ "Unique Visitors", number_with_delimiter(@summary.active_users) ],
              [ "Sessions", number_with_delimiter(@summary.sessions) ],
              [ "Total Pageviews", number_with_delimiter(@summary.page_views) ],
              [ "Bounce Rate", analytics_percentage(@summary.bounce_rate) ],
              [ "Average Session", analytics_duration(@summary.session_duration) ]
            ] %>

        <div class="p-3">
          <div class="rounded-md border border-[#383838] bg-[#1d1d1d]">
            <div class="flex items-start justify-between gap-4 border-b border-[#383838] px-3 py-3">
              <div>
                <p class="text-xs font-semibold text-neutral-200">Audience trend</p>
                <p class="mt-1 text-[0.65rem] text-neutral-600">Daily active users across the selected period</p>
              </div>
              <span class="inline-flex items-center gap-1.5 rounded border border-yellow-500/30 bg-yellow-500/10 px-2 py-1 text-[0.58rem] font-medium uppercase tracking-wide text-yellow-300">
                <span class="h-1.5 w-1.5 rounded-full bg-yellow-400" aria-hidden="true"></span>
                Live data
              </span>
            </div>

            <div class="p-3">
              <% if @summary.daily_series.any? %>
                <%= area_chart @summary.daily_series.to_h { |point| [ point.date.strftime("%d %b"), point.active_users ] },
                      height: "360px", colors: [ "#facc15" ], legend: false, curve: false,
                      library: { interaction: { mode: "index" } } %>
              <% else %>
                <div class="h-[360px] flex items-center justify-center">
                  <p class="text-xs text-neutral-600">No data for this period.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </section>

    <aside class="bg-[#1b1b1b]" aria-label="Platform and traffic summaries">
      <section class="border-b border-[#383838]">
        <div class="flex items-center justify-between border-b border-[#383838] px-3 py-3">
          <div>
            <h2 class="text-xs font-semibold text-neutral-200">Platform status</h2>
            <p class="mt-1 text-[0.62rem] text-neutral-600">Current totals</p>
          </div>
          <span class="h-6 w-6 rounded-full border border-[#444] text-yellow-400 flex items-center justify-center text-xs" aria-hidden="true">↗</span>
        </div>

        <div id="platform-counts">
          <%= render "card",
                section: :bands,
                label: "Pending bands",
                count: @pending_bands_count,
                link_label: "Review queue",
                link_path: admin_bands_path(status: "pending") %>

          <%= render "card",
                section: :bands,
                label: "Total bands",
                count: @bands_count,
                link_label: "Manage bands",
                link_path: admin_bands_path %>

          <%= render "card",
                section: :users,
                label: "Total users",
                count: @users_count,
                link_label: "Manage users",
                link_path: admin_users_path %>
        </div>
      </section>

      <% if @summary %>
        <%= render "admin/analytics/breakdown", title: "Sources", count_header: "Sessions",
              rows: @summary.channels, count_method: :sessions, accent: "bg-yellow-400/15", limit: 5 %>

        <%= render "admin/analytics/breakdown", title: "Top pages", count_header: "Pageviews",
              rows: @summary.top_pages, count_method: :views, label_method: :path,
              accent: "bg-neutral-500/20", limit: 5 %>
      <% end %>
    </aside>
  </div>
</div>
