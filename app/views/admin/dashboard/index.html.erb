<% content_for :title, "Dashboard — Admin — SceneCore" %>

<p class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-2">Visão geral</p>
<h1 class="text-3xl font-extrabold tracking-tight mb-8">Dashboard</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
    <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Bandas pendentes</p>
    <p class="text-3xl font-extrabold"><%= @pending_bands_count %></p>
    <%= link_to "Ver bandas", admin_bands_path(status: "pending"), class: "text-sm text-yellow-400 hover:text-yellow-300 transition" %>
  </div>

  <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
    <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Total de bandas</p>
    <p class="text-3xl font-extrabold"><%= @bands_count %></p>
    <%= link_to "Ver todas", admin_bands_path, class: "text-sm text-yellow-400 hover:text-yellow-300 transition" %>
  </div>

  <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
    <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Total de usuários</p>
    <p class="text-3xl font-extrabold"><%= @users_count %></p>
    <%= link_to "Ver usuários", admin_users_path, class: "text-sm text-yellow-400 hover:text-yellow-300 transition" %>
  </div>
</div>
