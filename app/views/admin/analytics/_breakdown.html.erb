<%# The Sources / Pages / Countries / Devices lists from the reference: each
    row is a bar whose width is the row's share of the largest row, with the
    label over the bar and the count aligned right. Scaling against the
    largest row rather than the total keeps the top row full-width, which is
    what makes the shape of the distribution readable at a glance. %>
<%# label_method varies by source: the breakdown structs carry :label,
    while the page structs carry :path. %>
<% label_method = local_assigns.fetch(:label_method, :label) %>
<% capitalize_labels = local_assigns.fetch(:capitalize_labels, false) %>
<% rows = Array(rows).first(local_assigns.fetch(:limit, 6)) %>
<% largest = rows.map { |r| r.public_send(count_method) }.max.to_i %>

<div class="border-b border-[#383838] bg-[#202020] p-3.5 last:border-b-0">
  <div class="flex items-baseline justify-between gap-4 mb-3">
    <h2 class="text-xs font-semibold text-neutral-200"><%= title %></h2>
    <span class="text-[0.6rem] uppercase tracking-[0.14em] text-neutral-600"><%= count_header %></span>
  </div>

  <% if rows.empty? %>
    <p class="text-neutral-600 text-xs">No data for this period.</p>
  <% else %>
    <ul class="flex flex-col gap-1.5">
      <% rows.each do |row| %>
        <% count = row.public_send(count_method).to_i %>
        <li class="relative flex items-center justify-between gap-4 rounded px-2 py-1.5 overflow-hidden">
          <%# The bar sits behind the text rather than beside it, so a long
              label never squeezes the bar into an unreadable sliver. %>
          <span
            class="absolute inset-y-0 left-0 rounded-lg <%= accent %> pointer-events-none"
            style="width: <%= largest.positive? ? (count * 100.0 / largest).round(2) : 0 %>%"
            aria-hidden="true"
          ></span>

          <% label = row.public_send(label_method).to_s %>
          <% label = label.capitalize if capitalize_labels %>
          <span class="relative text-xs text-neutral-300 truncate" title="<%= label %>"><%= label %></span>
          <span class="relative text-xs font-semibold text-neutral-100 shrink-0"><%= number_with_delimiter(count) %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
