<% content_for :title, "Analytics — Admin — SceneCore" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-2">
    <h1 class="text-3xl font-extrabold tracking-tight">Analytics</h1>

    <div class="flex items-center gap-2">
      <% GoogleAnalyticsClient::ALLOWED_DAY_RANGES.each do |range| %>
        <%= link_to "#{range}d", admin_analytics_path(days: range), class: "rounded-full text-xs font-semibold px-3 py-1.5 transition #{@days == range ? "bg-yellow-400 text-black" : "border border-neutral-700 text-white hover:border-neutral-500"}" %>
      <% end %>
    </div>
  </div>
  <p class="text-neutral-500 mb-8">Site traffic across all bands, last <%= @days %> days, from Google Analytics.</p>

  <% unless GoogleAnalyticsClient.configured? %>
    <p class="text-neutral-500">
      Google Analytics isn't configured yet — set <code>GOOGLE_ANALYTICS_PROPERTY_ID</code> and either a
      service account credentials file at <code>config/google_analytics_credentials.json</code> or the
      <code>GOOGLE_ANALYTICS_CREDENTIALS_JSON</code> environment variable.
    </p>
  <% end %>

  <% if @error %>
    <p class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4"><%= @error %></p>
  <% end %>

  <% if @summary %>
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Users</p>
        <p class="text-3xl font-extrabold"><%= number_with_delimiter(@summary.active_users) %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Sessions</p>
        <p class="text-3xl font-extrabold"><%= number_with_delimiter(@summary.sessions) %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Pageviews</p>
        <p class="text-3xl font-extrabold"><%= number_with_delimiter(@summary.page_views) %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Bounce rate</p>
        <p class="text-3xl font-extrabold"><%= analytics_percentage(@summary.bounce_rate) %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Session duration</p>
        <p class="text-3xl font-extrabold"><%= analytics_duration(@summary.session_duration) %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <div class="lg:col-span-2 rounded-xl border border-neutral-800 bg-neutral-900/60 p-5">
        <h2 class="text-sm font-semibold text-neutral-300 mb-4">Users vs Bounce Rate</h2>
        <% if @summary.daily_series.any? %>
          <%= line_chart [
                { name: "Users", data: @summary.daily_series.to_h { |p| [ p.date.strftime("%d %b"), p.active_users ] } },
                { name: "Bounce rate (%)", data: @summary.daily_series.to_h { |p| [ p.date.strftime("%d %b"), (p.bounce_rate.to_f * 100).round(1) ] } }
              ],
              height: "260px", colors: [ "#4ade80", "#facc15" ], library: { interaction: { mode: "index" } } %>
        <% else %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% end %>
      </div>

      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 p-5">
        <h2 class="text-sm font-semibold text-neutral-300 mb-4">Users by device</h2>
        <% if @summary.devices.any? %>
          <%= pie_chart @summary.devices.to_h { |d| [ d.label.capitalize, d.sessions ] },
                donut: true, height: "260px", colors: [ "#facc15", "#4ade80", "#60a5fa", "#f87171" ] %>
        <% else %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 p-5">
        <h2 class="text-sm font-semibold text-neutral-300 mb-4">Top traffic sources</h2>
        <% if @summary.channels.any? %>
          <%= bar_chart @summary.channels.first(5).to_h { |c| [ c.label, c.sessions ] },
                height: "220px", colors: [ "#facc15" ], legend: false %>
        <% else %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% end %>
      </div>

      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 p-5">
        <h2 class="text-sm font-semibold text-neutral-300 mb-4">Top 5 viewed pages</h2>
        <% if @summary.top_pages.any? %>
          <%= bar_chart @summary.top_pages.first(5).to_h { |p| [ p.path, p.views ] },
                height: "220px", colors: [ "#4ade80" ], legend: false %>
        <% else %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Top 10 viewed pages by unique pageviews</h2>
        <%= render "table", rows: @summary.top_pages, count_header: "Pageviews", count_method: :views %>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Top 10 landing pages by users</h2>
        <%= render "table", rows: @summary.landing_pages || [], count_header: "Users", count_method: :users %>
      </div>
    </div>
  <% end %>
</div>
