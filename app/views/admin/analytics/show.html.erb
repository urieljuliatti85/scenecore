<% content_for :title, "Analytics — Admin — SceneCore" %>

<div class="max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-1">
    <h1 class="text-3xl font-extrabold tracking-tight">Analytics</h1>

    <div class="flex items-center gap-2">
      <% GoogleAnalyticsClient::ALLOWED_DAY_RANGES.each do |range| %>
        <%= link_to "Last #{range} days", admin_analytics_path(days: range), class: "rounded-lg text-xs font-semibold px-3 py-2 transition #{@days == range ? "bg-neutral-800 text-white" : "text-neutral-400 hover:text-white hover:bg-neutral-900"}" %>
      <% end %>
    </div>
  </div>
  <p class="text-neutral-500 mb-8">Site traffic across all bands, last <%= @days %> days, from Google Analytics.</p>

  <% unless GoogleAnalyticsClient.configured? %>
    <p class="text-neutral-500">
      Google Analytics isn't configured yet — set <code>GOOGLE_ANALYTICS_PROPERTY_ID</code> and either a
      service account credentials file at <code>config/google_analytics_credentials.json</code> or the
      <code>GOOGLE_ANALYTICS_CREDENTIALS_JSON</code> environment variable.
    </p>
  <% end %>

  <% if @error %>
    <p class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4"><%= @error %></p>
  <% end %>

  <% if @summary %>
    <%= render "metric_row", metrics: [
          [ "Unique Visitors", number_with_delimiter(@summary.active_users) ],
          [ "Sessions", number_with_delimiter(@summary.sessions) ],
          [ "Total Pageviews", number_with_delimiter(@summary.page_views) ],
          [ "Bounce Rate", analytics_percentage(@summary.bounce_rate) ],
          [ "Average Session", analytics_duration(@summary.session_duration) ]
        ] %>

    <div class="py-8 border-b border-neutral-800 mb-8">
      <% if @summary.daily_series.any? %>
        <%= area_chart @summary.daily_series.to_h { |p| [ p.date.strftime("%d %b"), p.active_users ] },
              height: "280px", colors: [ "#facc15" ], legend: false, curve: false,
              library: { interaction: { mode: "index" } } %>
      <% else %>
        <p class="text-neutral-500 text-sm">No data for this period.</p>
      <% end %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <%= render "breakdown", title: "Sources", count_header: "Sessions",
            rows: @summary.channels, count_method: :sessions, accent: "bg-yellow-500/15" %>

      <%= render "breakdown", title: "Pages", count_header: "Pageviews",
            rows: @summary.top_pages, count_method: :views, label_method: :path,
            accent: "bg-emerald-500/15" %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">
      <%= render "breakdown", title: "Countries", count_header: "Sessions",
            rows: @summary.countries || [], count_method: :sessions, accent: "bg-sky-500/15" %>

      <%= render "breakdown", title: "Devices", count_header: "Sessions",
            rows: @summary.devices, count_method: :sessions, accent: "bg-violet-500/15",
            capitalize_labels: true %>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Top 10 viewed pages by unique pageviews</h2>
        <%= render "table", rows: @summary.top_pages, count_header: "Pageviews", count_method: :views %>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Top 10 landing pages by users</h2>
        <%= render "table", rows: @summary.landing_pages || [], count_header: "Users", count_method: :users %>
      </div>
    </div>
  <% end %>
</div>
