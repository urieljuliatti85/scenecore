<% content_for :title, "Analytics — Admin — SceneCore" %>

<div class="max-w-4xl">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-2">
    <h1 class="text-3xl font-extrabold tracking-tight">Analytics</h1>

    <div class="flex items-center gap-2">
      <% GoogleAnalyticsClient::ALLOWED_DAY_RANGES.each do |range| %>
        <%= link_to "#{range}d", admin_analytics_path(days: range), class: "rounded-full text-xs font-semibold px-3 py-1.5 transition #{@days == range ? "bg-yellow-400 text-black" : "border border-neutral-700 text-white hover:border-neutral-500"}" %>
      <% end %>
    </div>
  </div>
  <p class="text-neutral-500 mb-8">Site traffic across all bands, last <%= @days %> days, from Google Analytics.</p>

  <% unless GoogleAnalyticsClient.configured? %>
    <p class="text-neutral-500">
      Google Analytics isn't configured yet — set <code>GOOGLE_ANALYTICS_PROPERTY_ID</code> and either a
      service account credentials file at <code>config/google_analytics_credentials.json</code> or the
      <code>GOOGLE_ANALYTICS_CREDENTIALS_JSON</code> environment variable.
    </p>
  <% end %>

  <% if @error %>
    <p class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4"><%= @error %></p>
  <% end %>

  <% if @summary %>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Active users</p>
        <p class="text-3xl font-extrabold"><%= @summary.active_users %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Sessions</p>
        <p class="text-3xl font-extrabold"><%= @summary.sessions %></p>
      </div>
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-6 py-5">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Page views</p>
        <p class="text-3xl font-extrabold"><%= @summary.page_views %></p>
      </div>
    </div>

    <% if @summary.daily_series.any? %>
      <div class="mb-8">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-neutral-500 mb-2">Active users per day</h2>
        <div class="flex items-end gap-1 h-24">
          <% max_users = [ @summary.daily_series.map(&:active_users).max, 1 ].max %>
          <% @summary.daily_series.each do |point| %>
            <div class="flex-1 flex flex-col items-center gap-1" title="<%= point.date.strftime("%d %b") %>: <%= point.active_users %>">
              <div class="w-full bg-yellow-400/70 rounded-t" style="height: <%= (point.active_users.to_f / max_users * 100).round %>%"></div>
              <% if @days <= 30 %>
                <span class="text-[9px] text-neutral-600"><%= point.date.strftime("%-d") %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-8">
      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Traffic sources</h2>
        <% if @summary.channels.empty? %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% else %>
          <ul class="space-y-2">
            <% @summary.channels.each do |channel| %>
              <li class="flex items-center justify-between rounded-lg border border-neutral-800 bg-neutral-900/60 px-4 py-2.5">
                <span class="text-sm text-neutral-300"><%= channel.label %></span>
                <span class="text-sm text-white font-semibold"><%= channel.sessions %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-300 mb-3">Devices</h2>
        <% if @summary.devices.empty? %>
          <p class="text-neutral-500 text-sm">No data for this period.</p>
        <% else %>
          <ul class="space-y-2">
            <% @summary.devices.each do |device| %>
              <li class="flex items-center justify-between rounded-lg border border-neutral-800 bg-neutral-900/60 px-4 py-2.5">
                <span class="text-sm text-neutral-300 capitalize"><%= device.label %></span>
                <span class="text-sm text-white font-semibold"><%= device.sessions %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    </div>

    <h2 class="text-sm font-semibold text-neutral-300 mb-3">Top pages</h2>
    <% if @summary.top_pages.empty? %>
      <p class="text-neutral-500">No page view data for this period.</p>
    <% else %>
      <ul class="space-y-2">
        <% @summary.top_pages.each do |page| %>
          <li class="flex items-center justify-between rounded-lg border border-neutral-800 bg-neutral-900/60 px-4 py-2.5">
            <span class="text-sm text-neutral-300 font-mono"><%= page.path %></span>
            <span class="text-sm text-white font-semibold"><%= page.views %></span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</div>
