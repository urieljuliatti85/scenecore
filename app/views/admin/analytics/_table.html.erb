<%# Shared by the viewed-pages and landing-pages tables: same columns, only
    the leading count differs (pageviews vs users). %>
<% if rows.empty? %>
  <p class="text-neutral-500 text-sm">No data for this period.</p>
<% else %>
  <div class="overflow-x-auto rounded-xl border border-neutral-800">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-neutral-800 bg-neutral-900/60">
          <th class="text-left font-semibold text-neutral-400 px-4 py-3">Page</th>
          <th class="text-right font-semibold text-neutral-400 px-4 py-3"><%= count_header %></th>
          <th class="text-right font-semibold text-neutral-400 px-4 py-3">Bounce</th>
          <th class="text-right font-semibold text-neutral-400 px-4 py-3">Ø Session</th>
          <th class="text-right font-semibold text-neutral-400 px-4 py-3">Ø Time</th>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |row| %>
          <tr class="border-b border-neutral-900 last:border-0">
            <td class="px-4 py-3 font-mono text-neutral-300 max-w-xs truncate" title="<%= row.path %>"><%= row.path %></td>
            <td class="px-4 py-3 text-right text-white font-semibold"><%= number_with_delimiter(row.public_send(count_method)) %></td>
            <td class="px-4 py-3 text-right text-neutral-300"><%= analytics_percentage(row.bounce_rate) %></td>
            <td class="px-4 py-3 text-right text-neutral-300"><%= analytics_duration(row.avg_duration) %></td>
            <td class="px-4 py-3 text-right text-neutral-300"><%= analytics_duration(row.avg_time_on_page) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
