<% content_for :title, "Edit user — Admin — SceneCore" %>

<div class="max-w-xl">
  <h1 class="text-3xl font-extrabold tracking-tight mb-8">Edit user</h1>

  <%= form_with model: @user, url: admin_user_path(@user), class: "flex flex-col gap-5" do |form| %>
    <% if @user.errors.any? %>
      <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_field :name, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.email_field :email, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :password, "New password", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <p class="text-xs text-neutral-500 mb-1">Leave blank to keep the current password.</p>
      <%= form.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <label class="flex items-center gap-2 text-sm text-neutral-300">
      <%= form.check_box :platform_admin, class: "rounded border-neutral-700 bg-neutral-900 text-yellow-400 focus:ring-yellow-400" %>
      Platform admin
    </label>

    <%= form.submit "Update user", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start" %>
  <% end %>

  <%= button_to "Remove user", admin_user_path(@user), method: :delete, class: "mt-6 text-sm font-medium text-red-500 hover:text-red-400 transition cursor-pointer", form: { data: { turbo_confirm: "Permanently remove this user? This cannot be undone." } } %>

  <%= link_to "Back to users", admin_users_path, class: "inline-block mt-4 text-sm text-neutral-400 hover:text-white transition" %>
</div>
