<% content_for :title, "Verification requests — Admin — SceneCore" %>

<div class="max-w-3xl">
  <h1 class="text-3xl font-extrabold tracking-tight mb-2">Verification requests</h1>
  <p class="text-neutral-500 mb-8">Bands asking for the "Verified Band" badge.</p>

  <% if @band_verification_requests.empty? %>
    <p class="text-neutral-500">No requests.</p>
  <% else %>
    <ul class="space-y-3">
      <% @band_verification_requests.each do |band_verification_request| %>
        <li class="rounded-xl border border-neutral-800 bg-neutral-900/60 px-5 py-4">
          <div class="flex items-center justify-between gap-4">
            <p class="font-semibold text-white">
              <%= link_to band_verification_request.band.name, band_path(band_verification_request.band), class: "text-yellow-300 hover:text-yellow-200 transition" %>
            </p>
            <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-2 py-0.5"><%= band_verification_request.status.humanize %></span>
          </div>
          <p class="text-sm text-neutral-400 mt-1"><%= band_verification_request.email %> · requested <%= time_ago_in_words(band_verification_request.created_at) %> ago</p>

          <% if band_verification_request.pending? %>
            <div class="mt-3 flex items-center gap-2">
              <%= button_to "Approve", approve_admin_band_verification_request_path(band_verification_request), method: :patch, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-xs font-semibold px-3 py-1.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
              <%= button_to "Reject", reject_admin_band_verification_request_path(band_verification_request), method: :patch, class: "rounded-full border border-red-900 text-red-400 text-xs font-semibold px-3 py-1.5 hover:border-red-700 transition cursor-pointer" %>
            </div>
          <% elsif band_verification_request.email_sent? %>
            <div class="mt-3 flex items-center gap-2">
              <%= button_to "Re-send email", resend_admin_band_verification_request_path(band_verification_request), method: :patch, class: "rounded-full border border-neutral-700 text-neutral-300 text-xs font-semibold px-3 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
