<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-xl mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-3">Contact</h1>
  <p class="text-neutral-400 mb-8">
    Get in touch with the SceneCore team. If something is broken or you need
    help with your band's page, use
    <%= link_to "Support", support_path, class: "underline hover:text-neutral-300" %>.
  </p>

  <%= form_with model: @contact_message, url: contact_path, class: "flex flex-col gap-5" do |form| %>
    <% if @contact_message.errors.any? %>
      <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
        <% @contact_message.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= form.label :name, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_field :name, required: true, class: "w-full rounded-xl bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.email_field :email, required: true, class: "w-full rounded-xl bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :band, "Band", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <p class="text-xs text-neutral-500 mb-1">If you have one.</p>
      <%= form.text_field :band, class: "w-full rounded-xl bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <div>
      <%= form.label :message, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_area :message, rows: 6, required: true, class: "w-full rounded-xl bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <%= form.submit "Send message", class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start" %>
  <% end %>
</section>
