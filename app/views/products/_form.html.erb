<%= form_with model: [ band, product ], class: "flex flex-col gap-6", data: (product.new_record? ? { controller: "discogs-product-search", discogs_product_search_url_value: band_products_path(band, format: :json) } : {}) do |form| %>
  <% errors = product.errors.full_messages + product.variants.flat_map { |variant| variant.errors.full_messages.map { |message| "Variant: #{message}" } } %>
  <% if errors.any? %>
    <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
      <% errors.uniq.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <% if product.new_record? %>
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5">
      <div class="mb-4">
        <h2 class="text-lg font-semibold text-white">Import from Discogs</h2>
        <p class="text-sm text-neutral-500 mt-1">Optional. Search for the exact physical release. SceneCore imports release metadata only; you still set SKU, price and stock below.</p>
      </div>

      <div class="relative">
        <%= label_tag :discogs_product_search_query, "Release or artist", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <input type="text"
               data-discogs-product-search-target="query"
               data-action="input->discogs-product-search#search"
               placeholder="Artist, release, catalog number..."
               autocomplete="off"
               class="w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        <ul data-discogs-product-search-target="results" class="absolute z-10 w-full mt-1 rounded-lg bg-neutral-900 border border-neutral-800 max-h-72 overflow-y-auto"></ul>
      </div>

      <p data-discogs-product-search-target="selectedLabel" hidden class="text-sm text-neutral-300 mt-3"></p>
      <%= hidden_field_tag :discogs_release_id, params[:discogs_release_id], data: { discogs_product_search_target: "selectedId" } %>

      <p class="text-xs text-neutral-600 mt-4">
        This application uses Discogs’ API but is not affiliated with, sponsored or endorsed by Discogs. “Discogs” is a trademark of Zink Media, LLC.
      </p>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_field :name, required: true, data: (product.new_record? ? { discogs_product_search_target: "name" } : {}), class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    <% if product.new_record? %>
      <p class="text-xs text-neutral-600 mt-1">Selecting a Discogs release fills this field; the server verifies the title again when saving.</p>
    <% end %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.text_area :description, rows: 5, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
  </div>

  <div>
    <%= form.label :image, "Photo", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%# A Discogs import brings the release's front cover with it, so this
        is for replacing that or for a product that has none.

        persisted? guards the preview: after a failed create the product is
        unsaved while the imported cover is already attached in memory, and
        a URL for it needs a signed id only a saved record can produce. %>
    <% if product.persisted? && product.image.attached? %>
      <div class="flex items-center gap-4 mb-3">
        <%= image_tag product.image, class: "h-20 w-20 rounded-lg object-cover border border-neutral-800" %>
        <p class="text-xs text-neutral-500">
          <% if product.discogs? %>
            Imported from Discogs. Upload a file to replace it.
          <% else %>
            Upload a file to replace it.
          <% end %>
        </p>
      </div>
    <% end %>
    <%= form.file_field :image, accept: "image/png,image/jpeg,image/webp", class: "w-full text-sm text-neutral-300 file:mr-4 file:rounded-full file:border-0 file:bg-yellow-400 file:text-black file:font-semibold file:px-4 file:py-2 file:cursor-pointer" %>
  </div>

  <div>
    <%= form.label :shipping_cents, "Shipping (cents)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
    <%= form.number_field :shipping_cents, min: 0, step: 1, class: "w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5" %>
    <p class="text-xs text-neutral-600 mt-1">Charged once per order for this product, however many the fan buys. Leave at 0 for free shipping.</p>
  </div>

  <% if product.new_record? %>
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5">
      <h2 class="text-lg font-semibold text-white">First variant</h2>
      <p class="text-sm text-neutral-500 mt-1 mb-5">Every product is sold through a SKU. For an item with no size or color options, keep the name as “Default”.</p>

      <%= form.fields_for :variants do |variant_form| %>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <%= variant_form.label :name, "Variant name", class: "block text-sm font-medium text-neutral-300 mb-1" %>
            <%= variant_form.text_field :name, required: true, class: "w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5" %>
          </div>
          <div>
            <%= variant_form.label :sku, "SKU", class: "block text-sm font-medium text-neutral-300 mb-1" %>
            <%= variant_form.text_field :sku, required: true, placeholder: "VINYL-LP-001", class: "w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5" %>
          </div>
          <div>
            <%= variant_form.label :price_cents, "Price (cents)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
            <%= variant_form.number_field :price_cents, required: true, min: 0, step: 1, placeholder: "12000", class: "w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5" %>
            <p class="text-xs text-neutral-600 mt-1">Example: 12000 = $120.00.</p>
          </div>
          <div>
            <%= variant_form.label :stock_quantity, "Stock", class: "block text-sm font-medium text-neutral-300 mb-1" %>
            <%= variant_form.number_field :stock_quantity, required: true, min: 0, step: 1, class: "w-full rounded-lg bg-neutral-950 border border-neutral-800 text-white px-4 py-2.5" %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= form.submit submit_label, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start" %>
<% end %>
