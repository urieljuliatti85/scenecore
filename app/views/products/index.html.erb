<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-5xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
    <div>
      <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Band Admin · Store</p>
      <h1 class="text-3xl font-extrabold tracking-tight">Products</h1>
      <p class="text-neutral-400 mt-2"><%= @band.name %></p>
    </div>

    <%= link_to "New product", new_band_product_path(@band), class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition self-start" %>
  </div>

  <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <p class="font-semibold text-white">Payments</p>
        <p class="text-sm text-neutral-400 mt-1">
          Stripe Connect status: <span class="text-neutral-200"><%= @band.stripe_connect_status.humanize %></span>.
          <% if @band.payouts_ready? %>
            Fans can buy from your Store and start memberships.
          <% else %>
            Products can be prepared now, but fans can't buy them — or start a membership — until your account is active.
          <% end %>
        </p>
      </div>

      <%= link_to @band.payouts_ready? ? "Payment settings" : "Set up payments", band_payments_path(@band), class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition whitespace-nowrap" %>
    </div>
  </div>

  <%= render "list", band: @band, products: @products %>

  <div class="mt-8">
    <%= link_to "← Back to Band Admin", band_path(@band), class: "text-sm text-neutral-400 hover:text-white transition" %>
  </div>
</section>
