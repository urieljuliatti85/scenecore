<% content_for :title, "Checkout — SceneCore" %>

<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <%= link_to cart_path, class: "text-sm text-neutral-400 hover:text-white transition" do %>
    &larr; Back to cart
  <% end %>

  <h1 class="mt-4 text-3xl font-extrabold tracking-tight mb-2">Checkout</h1>
  <p class="text-neutral-400 mb-8">Ordering from <%= @cart.band.name %>.</p>

  <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-8">
    <h2 class="text-sm font-semibold text-white mb-4">Order summary</h2>

    <ul class="flex flex-col gap-2 text-sm mb-4">
      <% @cart.cart_items.each do |item| %>
        <li class="flex items-start justify-between gap-4">
          <span class="text-neutral-300 min-w-0">
            <%= item.quantity %>&times; <%= item.product_variant.product.name %>
            <span class="text-neutral-500">(<%= item.product_variant.name %>)</span>
          </span>
          <span class="text-white shrink-0">
            <%= number_to_currency(item.quantity * item.product_variant.price_cents / 100.0) %>
          </span>
        </li>
      <% end %>
    </ul>

    <dl class="flex flex-col gap-2 text-sm border-t border-neutral-800 pt-4">
      <div class="flex items-center justify-between">
        <dt class="text-neutral-400">Subtotal</dt>
        <dd class="text-white"><%= number_to_currency(@cart.subtotal_cents / 100.0) %></dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-neutral-400">Shipping</dt>
        <dd class="text-white">
          <%= @cart.shipping_cents.zero? ? "Free" : number_to_currency(@cart.shipping_cents / 100.0) %>
        </dd>
      </div>
      <div class="flex items-center justify-between pt-3 mt-1 border-t border-neutral-800">
        <dt class="font-semibold text-white">Total</dt>
        <dd class="text-xl font-extrabold text-white"><%= number_to_currency(@cart.total_cents / 100.0) %></dd>
      </div>
    </dl>
  </div>

  <h2 class="text-sm font-semibold text-white mb-4">Shipping address</h2>

  <%= form_with model: @shipping_address, url: checkout_path, class: "flex flex-col gap-5" do |form| %>
    <% if @shipping_address.errors.any? %>
      <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
        <% @shipping_address.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= form.label :recipient_name, "Recipient name", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_field :recipient_name, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
    </div>

    <div>
      <%= form.label :line1, "Address", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_field :line1, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
    </div>

    <div>
      <%= form.label :line2, "Address line 2 (optional)", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.text_field :line2, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :city, "City", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.text_field :city, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
      </div>
      <div>
        <%= form.label :state, "State", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.text_field :state, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
      </div>
      <div>
        <%= form.label :postal_code, "Postal code", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.text_field :postal_code, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
      </div>
      <div>
        <%= form.label :country, "Country", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.text_field :country, required: true, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5" %>
      </div>
    </div>

    <p class="text-xs text-neutral-600">
      You'll be taken to Stripe to pay. Your card details never reach SceneCore.
    </p>

    <%= form.submit "Continue to payment", class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start" %>
  <% end %>
</section>
