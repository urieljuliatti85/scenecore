<% content_for :title, "Your cart — SceneCore" %>

<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-8">Your cart</h1>

  <%# Adding another band's product would replace this cart, so the switch is
      confirmed rather than applied silently (ADR-003: one band per cart). %>
  <% if @pending_variant && @cart %>
    <div class="rounded-2xl border border-yellow-500/30 bg-yellow-400/5 p-5 mb-6">
      <p class="text-white font-semibold mb-1">Start a cart for <%= @pending_variant.product.band.name %>?</p>
      <p class="text-sm text-neutral-400 mb-4">
        A cart holds one band's products at a time. Adding
        <span class="text-neutral-200"><%= @pending_variant.product.name %></span>
        will empty your current cart from <%= @cart.band.name %>.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <%= button_to "Switch cart", add_cart_path,
              params: { product_variant_id: @pending_variant.id, confirm_switch: "1" },
              class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 text-sm font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer" %>
        <%= link_to "Keep my cart", cart_path, class: "text-sm text-neutral-400 hover:text-white transition" %>
      </div>
    </div>
  <% end %>

  <% if @cart.nil? || @cart.cart_items.empty? %>
    <p class="text-neutral-500">Your cart is empty.</p>
    <%= link_to "Discover bands", discover_bands_path, class: "inline-block mt-4 rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
  <% else %>
    <p class="text-sm text-neutral-500 mb-6">
      From <%= link_to @cart.band.name, public_band_path(@cart.band.slug), class: "text-neutral-300 hover:text-white transition" %>
    </p>

    <ul class="flex flex-col gap-3 mb-8">
      <% @cart.cart_items.each do |item| %>
        <li class="rounded-2xl border border-neutral-800 bg-neutral-900/60 px-5 py-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="min-w-0">
            <p class="font-semibold text-white truncate"><%= item.product_variant.product.name %></p>
            <p class="text-sm text-neutral-500 mt-1">
              <%= item.product_variant.name %> · <%= number_to_currency(item.product_variant.price_cents / 100.0) %> each
            </p>
          </div>

          <div class="flex items-center gap-4 shrink-0">
            <%= form_with url: update_item_cart_path, method: :patch, class: "flex items-center gap-2" do |form| %>
              <%= form.hidden_field :cart_item_id, value: item.id %>
              <%= form.label :quantity, "Qty", class: "text-xs uppercase tracking-wide text-neutral-500" %>
              <%= form.number_field :quantity, value: item.quantity, min: 0, max: item.product_variant.stock_quantity,
                    class: "w-16 rounded-lg bg-neutral-950 border border-neutral-800 text-white px-2 py-1.5 text-sm" %>
              <%= form.submit "Update", class: "text-xs font-medium text-neutral-400 hover:text-white transition cursor-pointer bg-transparent border-0 p-0" %>
            <% end %>

            <p class="text-white font-bold w-20 text-right">
              <%= number_to_currency(item.quantity * item.product_variant.price_cents / 100.0) %>
            </p>

            <%= button_to "Remove", remove_item_cart_path, method: :delete,
                  params: { cart_item_id: item.id },
                  class: "text-sm font-medium text-red-500 hover:text-red-400 transition cursor-pointer" %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-6">
      <dl class="flex flex-col gap-2 text-sm">
        <div class="flex items-center justify-between">
          <dt class="text-neutral-400">Subtotal</dt>
          <dd class="text-white"><%= number_to_currency(@cart.subtotal_cents / 100.0) %></dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-neutral-400">Shipping</dt>
          <dd class="text-white">
            <%= @cart.shipping_cents.zero? ? "Free" : number_to_currency(@cart.shipping_cents / 100.0) %>
          </dd>
        </div>
        <div class="flex items-center justify-between pt-3 mt-1 border-t border-neutral-800">
          <dt class="font-semibold text-white">Total</dt>
          <dd class="text-xl font-extrabold text-white"><%= number_to_currency(@cart.total_cents / 100.0) %></dd>
        </div>
      </dl>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= link_to "Checkout", new_checkout_path, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
      <%= button_to "Empty cart", cart_path, method: :delete,
            class: "text-sm text-neutral-400 hover:text-white transition cursor-pointer",
            form: { data: { turbo_confirm: "Empty your cart?" } } %>
    </div>
  <% end %>
</section>
