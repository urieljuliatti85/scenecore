<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <%= link_to band_path(@band), class: "text-sm text-neutral-400 hover:text-white transition" do %>
    &larr; <%= @band.name %>
  <% end %>

  <div class="mt-4 flex flex-col sm:flex-row gap-6">
    <div class="w-full sm:w-48 aspect-square rounded-2xl border border-neutral-800 bg-neutral-800 overflow-hidden flex items-center justify-center shrink-0">
      <% if @album.cover_url.present? %>
        <%= image_tag @album.cover_url, class: "w-full h-full object-cover" %>
      <% else %>
        <span class="text-neutral-600 text-sm">No cover</span>
      <% end %>
    </div>

    <div class="flex-1">
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-extrabold tracking-tight"><%= @album.title %></h1>
        <span class="text-xs uppercase tracking-wide text-neutral-500 border border-neutral-700 rounded-full px-3 py-1"><%= @album.status %></span>
        <% if @album.in_early_access? %>
          <span class="text-xs uppercase tracking-wide text-yellow-400 border border-yellow-900 rounded-full px-3 py-1">
            <%= @album.early_access_level.humanize %>+ early access until <%= @album.early_access_until.strftime("%b %-d, %Y %H:%M") %>
          </span>
        <% end %>
      </div>

      <%# The href is assembled from a literal plus the validated id, so the
          scheme and host are fixed here rather than coming out of the
          database. See Album#spotify_url for the id check. %>
      <% if (spotify_album_id = @album.spotify_link_id) %>
        <%= link_to "https://open.spotify.com/album/#{spotify_album_id}", target: "_blank", rel: "noopener", class: "mt-4 inline-flex items-center gap-2 rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-1.5 hover:border-neutral-500 transition" do %>
          <%= render "shared/spotify_icon", classes: "h-4 w-4 shrink-0" %>
          Listen on Spotify
        <% end %>
      <% end %>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <% if policy(@album).publish? && @album.draft? %>
          <%= button_to "Publish", publish_band_album_path(@band, @album), method: :patch, class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-1.5 hover:bg-yellow-300 transition cursor-pointer" %>
        <% end %>

        <% if policy(@album).unpublish? && @album.published? %>
          <%= button_to "Unpublish", unpublish_band_album_path(@band, @album), method: :patch, class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
        <% end %>

        <% if policy(@album).update? %>
          <%= link_to "Edit", edit_band_album_path(@band, @album), class: "text-sm text-neutral-400 hover:text-white transition" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if policy(@album).update? %>
    <div class="mt-8 rounded-2xl border border-neutral-800 bg-neutral-900/40 px-5 py-4">
      <h2 class="text-sm font-semibold text-neutral-300">Update album artwork</h2>

      <% if @album.spotify_id.present? %>
        <p class="text-xs text-neutral-500 mt-1">Re-read the cover Spotify currently has for this album.</p>
        <%= button_to "Refetch from Spotify", refetch_cover_band_album_path(@band, @album), method: :patch, class: "mt-3 rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-1.5 hover:border-neutral-500 transition cursor-pointer" %>
      <% end %>

      <%= form_with url: cover_from_url_band_album_path(@band, @album), method: :patch, class: "mt-4 flex flex-col sm:flex-row gap-2 sm:items-center" do |form| %>
        <%= form.url_field :cover_url, placeholder: "https://example.com/cover.jpg", required: true, class: "flex-1 rounded-full bg-neutral-900 border border-neutral-800 text-white text-sm px-4 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        <%= form.submit "Use this image", class: "rounded-full bg-yellow-400 text-black text-sm font-semibold px-4 py-2 hover:bg-yellow-300 transition cursor-pointer" %>
      <% end %>
      <p class="text-xs text-neutral-500 mt-2">PNG, JPEG or WebP, up to 5MB. You can also <%= link_to "upload a file", edit_band_album_path(@band, @album), class: "underline hover:text-neutral-300" %>.</p>
    </div>
  <% end %>

</section>
