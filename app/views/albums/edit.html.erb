<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-xl mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-2">Edit album</h1>
  <p class="text-neutral-500 mb-8"><%= @band.name %> · <%= @album.title %></p>

  <%= form_with model: [ @band, @album ], class: "flex flex-col gap-5" do |form| %>
    <% if @album.errors.any? %>
      <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1">
        <% @album.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= form.label :cover, class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <p class="text-xs text-neutral-500 mb-1">PNG, JPEG or WebP, up to 5MB</p>
      <% if @album.cover.attached? && @album.cover.persisted? %>
        <%= image_tag @album.cover, class: "w-32 h-32 object-cover rounded-lg mb-2" %>
      <% end %>
      <%= form.file_field :cover, accept: "image/png,image/jpeg,image/webp", class: "w-full text-sm text-neutral-300 file:mr-4 file:rounded-full file:border-0 file:bg-yellow-400 file:text-black file:font-semibold file:px-4 file:py-2 file:cursor-pointer" %>
    </div>

    <div class="pt-4 border-t border-neutral-800">
      <h2 class="text-sm font-semibold text-neutral-300 mb-1">Early access</h2>
      <p class="text-xs text-neutral-500 mb-3">Give supporters early access to this album before it's publicly available.</p>

      <%= form.label :early_access_level, "Minimum membership", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.select :early_access_level, options_for_select(Album.early_access_levels.keys.map { |level| [ level.humanize, level ] }, @album.early_access_level), { include_blank: "No early access" }, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400 mb-3" %>

      <%= form.label :early_access_until, "Public release time", class: "block text-sm font-medium text-neutral-300 mb-1" %>
      <%= form.datetime_field :early_access_until, value: @album.early_access_until&.strftime("%Y-%m-%dT%H:%M"), class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
    </div>

    <%= form.submit "Save changes", class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start" %>
  <% end %>

  <div class="mt-10 pt-8 border-t border-neutral-800">
    <h2 class="text-sm font-semibold text-neutral-300">Spotify</h2>
    <p class="text-xs text-neutral-500 mt-1 mb-4">
      <% if @album.spotify_link_id %>
        This album links to Spotify. Search again to point it at a different release.
      <% else %>
        This album has no Spotify link yet, so fans see it without a "Listen on
        Spotify" button. Find it below to add one.
      <% end %>
    </p>

    <div data-controller="album-search" data-album-search-url-value="<%= search_band_albums_path(@band) %>" class="flex flex-col gap-3">
      <%= form_with url: band_album_path(@band, @album), method: :patch, class: "flex flex-col gap-5" do %>
        <div class="relative">
          <%= label_tag :album_spotify_search_query, "Search for this album on Spotify", class: "block text-sm font-medium text-neutral-300 mb-1" %>
          <input type="text" id="album_spotify_search_query" data-album-search-target="query" data-action="input->album-search#search" placeholder="Album or artist name..." autocomplete="off" class="w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400">
          <ul data-album-search-target="results" class="absolute z-10 w-full mt-1 rounded-lg bg-neutral-900 border border-neutral-800 max-h-64 overflow-y-auto"></ul>
        </div>

        <p data-album-search-target="selectedLabel" hidden class="text-sm text-neutral-300"></p>

        <%= hidden_field_tag :spotify_album_id, "", data: { album_search_target: "selectedId" } %>

        <%= submit_tag "Link to Spotify", data: { album_search_target: "submit" }, disabled: true, class: "rounded-full bg-yellow-400 text-black font-semibold px-6 py-3 hover:bg-yellow-300 transition cursor-pointer self-start disabled:opacity-40 disabled:cursor-not-allowed" %>
      <% end %>
    </div>
  </div>
</section>
