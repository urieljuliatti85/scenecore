<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-xl mx-auto">
  <h1 class="text-3xl font-extrabold tracking-tight mb-2">Add Album</h1>
  <p class="text-neutral-500 mb-8"><%= @band.name %></p>

  <% if @album.errors.any? %>
    <ul class="rounded-xl border border-red-900 bg-red-950/40 text-red-400 text-sm p-4 space-y-1 mb-5">
      <% @album.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div data-controller="album-search" data-album-search-url-value="<%= search_band_albums_path(@band) %>" class="flex flex-col gap-3">
    <%= form_with url: band_albums_path(@band), class: "flex flex-col gap-5" do |form| %>
      <div class="relative">
        <%= label_tag :album_search_query, "Search for an album on Spotify", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <input type="text" data-album-search-target="query" data-action="input->album-search#search" placeholder="Album or artist name..." autocomplete="off" class="w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400">
        <ul data-album-search-target="results" class="absolute z-10 w-full mt-1 rounded-lg bg-neutral-900 border border-neutral-800 max-h-64 overflow-y-auto"></ul>
      </div>

      <p data-album-search-target="selectedLabel" hidden class="text-sm text-neutral-300"></p>

      <%= hidden_field_tag :spotify_album_id, "", data: { album_search_target: "selectedId" } %>

      <%= form.submit "Add Album", data: { album_search_target: "submit" }, disabled: true, class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-6 py-3 hover:bg-yellow-400/20 hover:text-yellow-200 transition cursor-pointer self-start disabled:opacity-40 disabled:cursor-not-allowed" %>
    <% end %>
  </div>

  <div class="mt-10 pt-8 border-t border-neutral-800">
    <h2 class="text-sm font-semibold text-neutral-300 mb-1">Or add from Bandcamp</h2>
    <p class="text-xs text-neutral-500 mb-4">
      Bandcamp has no search here, so enter the title and paste the embed
      player URL from your Bandcamp album — go to Share/Embed on Bandcamp,
      choose a player size, and copy the <code>src</code> from the embed code
      (starts with <code>https://bandcamp.com/EmbeddedPlayer/...</code>).
    </p>

    <%= form_with url: band_albums_path(@band), scope: :album, class: "flex flex-col gap-5" do |form| %>
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.text_field :title, class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>

      <div>
        <%= form.label :bandcamp_embed_url, "Embed player URL", class: "block text-sm font-medium text-neutral-300 mb-1" %>
        <%= form.url_field :bandcamp_embed_url, placeholder: "https://bandcamp.com/EmbeddedPlayer/album=...", class: "w-full rounded-lg bg-neutral-900 border border-neutral-800 text-white px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
      </div>

      <%= form.submit "Add from Bandcamp", class: "rounded-full border border-neutral-700 text-white font-semibold px-6 py-3 hover:border-neutral-500 transition cursor-pointer self-start" %>
    <% end %>
  </div>
</section>
