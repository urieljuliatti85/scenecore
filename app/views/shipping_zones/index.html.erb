<% content_for :title, "Shipping — #{@band.name}" %>

<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-5xl mx-auto">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-8">
    <div>
      <p class="text-xs uppercase tracking-wide text-neutral-500 mb-2">Band Admin · Store</p>
      <h1 class="text-3xl font-extrabold tracking-tight">Shipping</h1>
      <p class="text-neutral-400 mt-2">Where <%= @band.name %> ships, and what it charges.</p>
    </div>

    <%= link_to "Add destination", new_band_shipping_zone_path(@band), class: "rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition self-start whitespace-nowrap" %>
  </div>

  <%# The rule that matters most and is least obvious: a country nobody
      listed cannot be bought, so this is a shipping list and a sales
      territory at once. %>
  <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-5 mb-8">
    <p class="text-sm text-neutral-400">
      A destination groups countries that cost the same to ship to — for example
      <span class="text-neutral-200">Brazil</span>,
      <span class="text-neutral-200">South America</span> and
      <span class="text-neutral-200">Rest of world</span>.
      Fans in a country you haven't listed can't check out, so add every place you're
      willing to post to. Individual products can charge their own rate for a
      destination when something is unusually heavy or light.
    </p>
  </div>

  <% if @zones.any? %>
    <div class="space-y-4">
      <% @zones.each do |zone| %>
        <article class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-5">
          <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5">
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-3">
                <h2 class="text-xl font-bold text-white"><%= zone.name %></h2>
                <span class="font-mono text-sm text-yellow-300">
                  <%= zone.shipping_cents.zero? ? "Free" : number_to_currency(zone.shipping_cents / 100.0) %>
                </span>
              </div>

              <p class="text-sm text-neutral-400 mt-2"><%= zone.country_names.to_sentence %></p>
              <p class="text-xs text-neutral-600 mt-1"><%= pluralize(zone.country_names.size, "country") %></p>
            </div>

            <div class="flex flex-wrap items-center gap-2 lg:justify-end shrink-0">
              <%= link_to "Edit", edit_band_shipping_zone_path(@band, zone), class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-4 py-2 hover:border-neutral-500 transition" %>
              <%= button_to "Delete", band_shipping_zone_path(@band, zone), method: :delete,
                    class: "text-sm text-red-400 hover:text-red-300 transition cursor-pointer",
                    form: { data: { turbo_confirm: "Stop shipping to #{zone.name}? Fans there won't be able to order." } } %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-dashed border-neutral-800 px-6 py-12 text-center">
      <p class="text-lg font-semibold text-white">No destinations yet</p>
      <p class="text-neutral-500 mt-2 max-w-md mx-auto">
        Until you add one, every product charges the flat shipping rate set on the
        product itself, anywhere in the world.
      </p>
      <%= link_to "Add your first destination", new_band_shipping_zone_path(@band), class: "inline-block mt-5 rounded-full bg-yellow-400/10 text-yellow-300 border border-yellow-500/30 font-semibold px-5 py-2.5 hover:bg-yellow-400/20 hover:text-yellow-200 transition" %>
    </div>
  <% end %>

  <div class="mt-8">
    <%= link_to "← Back to Band Admin", band_path(@band, tab: "products"), class: "text-sm text-neutral-400 hover:text-white transition" %>
  </div>
</section>
