<%# Shared by /bands/:id/payments and the panel's Payments tab, so the two
    cannot disagree about what the band's account can do. %>
<%= render "band_payments/status_card", band: band %>

<%# What is actually blocked right now, counted rather than described in
    general terms: a band with subscribers waiting is in a different
    situation from one with nothing set up yet. %>
<% unless band.payouts_ready? %>
  <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-6">
    <h2 class="text-sm font-semibold text-white mb-3">What this blocks</h2>
    <ul class="flex flex-col gap-2.5 text-sm text-neutral-300">
      <li class="flex items-start gap-2.5">
        <span class="text-red-400 mt-0.5" aria-hidden="true">&times;</span>
        <span>
          Fans can't start a membership with you.
          <% if active_subscribers.positive? %>
            <span class="text-neutral-500">
              Your <%= pluralize(active_subscribers, "existing subscriber") %>
              <%= active_subscribers == 1 ? "keeps" : "keep" %> their access.
            </span>
          <% end %>
        </span>
      </li>
      <li class="flex items-start gap-2.5">
        <span class="text-red-400 mt-0.5" aria-hidden="true">&times;</span>
        <span>
          Fans can't buy from your Store.
          <% if published_products.positive? %>
            <span class="text-neutral-500">
              <%= pluralize(published_products, "published product") %>
              <%= published_products == 1 ? "is" : "are" %> visible but can't be bought.
            </span>
          <% end %>
        </span>
      </li>
    </ul>
  </div>
<% end %>

<div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 mb-6">
  <h2 class="text-sm font-semibold text-white mb-3">What you keep</h2>
  <dl class="flex flex-col gap-3 text-sm">
    <div class="flex items-start justify-between gap-4">
      <dt class="text-neutral-300">
        Memberships
        <span class="block text-neutral-500 text-xs mt-0.5">Split on every monthly charge</span>
      </dt>
      <dd class="text-white font-bold shrink-0"><%= 100 - PlatformSetting.current.membership_fee_percentage %>%</dd>
    </div>
    <div class="flex items-start justify-between gap-4 pt-3 border-t border-neutral-800">
      <dt class="text-neutral-300">
        Store sales
        <span class="block text-neutral-500 text-xs mt-0.5">You supply and ship the goods, so the platform takes less</span>
      </dt>
      <dd class="text-white font-bold shrink-0"><%= 100 - PlatformSetting.current.store_fee_percentage %>%</dd>
    </div>
  </dl>
  <p class="text-xs text-neutral-600 mt-4">
    Your share reaches your Stripe account at the moment of each charge, not
    as a later payout from SceneCore.
    <%= link_to "How it works", how_it_works_path, class: "text-yellow-300 hover:text-yellow-200 transition" %>
    explains the rest.
  </p>
</div>

<% if band.payouts_ready? %>
  <section class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-5">
      <div>
        <h2 class="text-sm font-semibold text-white">Financial overview</h2>
        <p class="text-sm text-neutral-500 mt-1">Read directly from your connected Stripe account.</p>
      </div>

      <%= button_to "Open financial dashboard", stripe_dashboard_band_payments_path(band), method: :post,
            form: { data: { turbo: false } },
            class: "rounded-full border border-neutral-700 text-white text-sm font-semibold px-5 py-2.5 hover:border-neutral-500 transition cursor-pointer whitespace-nowrap" %>
    </div>

    <% if financial_summary_unavailable %>
      <div class="rounded-xl border border-yellow-500/30 bg-yellow-400/5 px-4 py-3">
        <p class="text-sm text-yellow-200">Financial information is temporarily unavailable.</p>
        <p class="text-xs text-neutral-500 mt-1">Your Stripe connection and ability to receive payments are not affected.</p>
      </div>
    <% else %>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-neutral-800 bg-neutral-950/50 p-5">
          <p class="text-xs uppercase tracking-wide text-neutral-500">Balance</p>
          <% if financial_summary.balances.any? %>
            <div class="mt-3 flex flex-col gap-4">
              <% financial_summary.balances.each do |balance| %>
                <div>
                  <p class="text-2xl font-extrabold text-white">
                    <%= number_to_currency(balance.available_cents / 100.0, unit: "#{balance.currency.upcase} ") %>
                  </p>
                  <p class="text-xs text-neutral-500 mt-1">
                    Available · <%= number_to_currency(balance.pending_cents / 100.0, unit: "#{balance.currency.upcase} ") %> pending
                  </p>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-lg font-bold text-white mt-3">No balance yet</p>
            <p class="text-xs text-neutral-500 mt-1">Your first payment will appear here.</p>
          <% end %>
        </div>

        <div class="rounded-xl border border-neutral-800 bg-neutral-950/50 p-5">
          <p class="text-xs uppercase tracking-wide text-neutral-500">Next payout</p>
          <% if financial_summary.next_payout %>
            <p class="text-2xl font-extrabold text-white mt-3">
              <%= number_to_currency(financial_summary.next_payout.amount_cents / 100.0,
                    unit: "#{financial_summary.next_payout.currency.upcase} ") %>
            </p>
            <p class="text-xs text-neutral-500 mt-1">
              Expected <%= l(financial_summary.next_payout.arrival_at.to_date, format: :long) %>
            </p>
          <% else %>
            <p class="text-lg font-bold text-white mt-3">No payout scheduled</p>
            <p class="text-xs text-neutral-500 mt-1">Stripe will show a date here when a payout is pending.</p>
          <% end %>
        </div>
      </div>
    <% end %>

    <p class="text-xs text-neutral-600 mt-4">
      Stripe holds your funds and sends payouts to your bank. SceneCore can display this summary but cannot move the money or change your bank details.
    </p>
  </section>
<% end %>
