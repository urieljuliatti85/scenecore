<% content_for :title, "Payments — #{@band.name} — SceneCore" %>

<section class="px-4 sm:px-6 py-12 sm:py-16 max-w-3xl mx-auto">
  <%= link_to band_path(@band), class: "text-sm text-neutral-400 hover:text-white transition" do %>
    &larr; <%= @band.name %>
  <% end %>

  <p class="mt-4 text-xs uppercase tracking-wide text-neutral-500 mb-2">Band Admin</p>
  <h1 class="text-3xl font-extrabold tracking-tight mb-2">Payments</h1>
  <p class="text-neutral-400 mb-8">
    Memberships and Store sales are paid to your own Stripe account. SceneCore
    never holds your money.
  </p>

  <%= render "panel", band: @band, active_subscribers: @active_subscribers,
        published_products: @published_products, financial_summary: @financial_summary,
        financial_summary_unavailable: @financial_summary_unavailable %>
</section>
